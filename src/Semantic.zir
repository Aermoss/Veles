#[include "std/str", "std/vec", "std/map", "src/Source.zir", "src/AST.zir" : *]

enum TypeKind: u8 {
    Error, Integer, Bits, Enum, Array, Clock, Reset
}

class Type {
    pub kind: TypeKind,
    pub width: u32 = 0,
    pub signed: bool = false,
    pub enumeration: *mut EnumInfo = null,
    pub element: *mut Type = null,
    pub length: u32 = 0;

    Type(&mut this, kind: TypeKind) {
        this.kind = kind;
    }

    pub fn IsError(&this) -> bool { this.kind == TypeKind::Error }
    pub fn IsInteger(&this) -> bool { this.kind == TypeKind::Integer }
    pub fn IsBits(&this) -> bool { this.kind == TypeKind::Bits }
    pub fn IsBool(&this) -> bool { this.kind == TypeKind::Bits && this.width == 1 && !this.signed }
    pub fn IsEnum(&this) -> bool { this.kind == TypeKind::Enum }
    pub fn IsArray(&this) -> bool { this.kind == TypeKind::Array }
    pub fn IsClock(&this) -> bool { this.kind == TypeKind::Clock }
    pub fn IsReset(&this) -> bool { this.kind == TypeKind::Reset }

    pub fn BitWidth(&this) -> u32 {
        match this.kind {
            TypeKind::Bits => this.width,
            TypeKind::Enum => this.enumeration->width,
            TypeKind::Clock | TypeKind::Reset => 1,
            _ => 0
        }
    }

    pub fn Describe(&this) -> String {
        match this.kind {
            TypeKind::Error => "<error>".ToString(),
            TypeKind::Integer => "integer".ToString(),
            TypeKind::Bits => {
                if this.width == 1 && !this.signed { return "bool".ToString(); }
                (if this.signed { "i" } else { "u" }) + String::FromInteger(this.width as u64)
            },
            TypeKind::Enum => this.enumeration->name,
            TypeKind::Array => "[" + this.element->Describe() + "; " + String::FromInteger(this.length as u64) + "]",
            TypeKind::Clock => "clock".ToString(),
            TypeKind::Reset => "reset".ToString()
        }
    }
}

fn SameType(a: *mut Type, b: *mut Type) -> bool {
    if a == b { return true; }
    if a == null || b == null || a->kind != b->kind { return false; }

    match a->kind {
        TypeKind::Bits => a->width == b->width && a->signed == b->signed,
        TypeKind::Enum => a->enumeration == b->enumeration,
        TypeKind::Array => a->length == b->length && SameType(a->element, b->element),
        _ => true
    }
}

class EnumInfo {
    pub name: String,
    pub item: *mut ASTEnumItem = null,
    pub width: u32 = 1,
    pub names: Vector<String>,
    pub values: Vector<i64>,
    pub _type: *mut Type = null,
    pub local: bool = false;

    EnumInfo(&mut this, name: &String, item: *mut ASTEnumItem) {
        (this.name, this.item) = (name, item);
    }

    pub fn Find(&this, name: &String) -> i64 {
        for i in 0..this.names.Length() {
            if this.names[i] == name { return i as i64; }
        }

        -1
    }

    pub fn FindValue(&this, value: i64) -> i64 {
        for i in 0..this.values.Length() {
            if this.values[i] == value { return i as i64; }
        }

        -1
    }
}

enum SymbolKind: u8 {
    Constant, Enumeration, Alias, Module, Port, Let, Wire, Register, Instance
}

extend SymbolKind {
    pub fn Describe(this) -> String {
        match this {
            SymbolKind::Constant => "constant",
            SymbolKind::Enumeration => "enum",
            SymbolKind::Alias => "type alias",
            SymbolKind::Module => "module",
            SymbolKind::Port => "port",
            SymbolKind::Let => "signal",
            SymbolKind::Wire => "wire",
            SymbolKind::Register => "register",
            SymbolKind::Instance => "instance"
        }.ToString()
    }
}

enum DriverKind: u8 {
    None, Input, Assign, Comb, Seq
}

class Symbol {
    pub kind: SymbolKind,
    pub name: String,
    pub span: SourceSpan,
    pub _type: *mut Type = null,
    pub scope: *mut Scope = null,
    pub value: i64 = 0,
    pub resolving: bool = false,
    pub resolved: bool = false,
    pub node: *mut ASTNode = null,
    pub enumeration: *mut EnumInfo = null,
    pub module: *mut ModuleInfo = null,
    pub input: bool = false,
    pub output: bool = false,
    pub registered: bool = false,
    pub init: *mut ASTExpression = null,
    pub power_on: bool = false,
    pub driver: DriverKind = DriverKind::None,
    pub driver_node: *mut ASTNode = null,
    pub driver_span: SourceSpan,
    pub instance: *mut ASTInstanceExpression = null;

    Symbol(&mut this, kind: SymbolKind, name: &String, span: SourceSpan) {
        (this.kind, this.name, this.span, this.driver_span) = (kind, name, span, span);
    }

    pub fn IsSignal(&this) -> bool {
        this.kind == SymbolKind::Port || this.kind == SymbolKind::Let || this.kind == SymbolKind::Wire || this.kind == SymbolKind::Register
    }
}

class Scope {
    pub parent: *mut Scope = null,
    pub symbols: Map<String, *mut Symbol>;

    Scope(&mut this, parent: *mut Scope) {
        this.parent = parent;
    }

    pub fn LookupLocal(&this, name: &String) -> *mut Symbol {
        match this.symbols.Get(name) {
            Option<*mut Symbol>::Some(symbol) => symbol,
            Option<*mut Symbol>::None => null
        }
    }

    pub fn Lookup(&this, name: &String) -> *mut Symbol {
        let symbol = this.LookupLocal(name);
        if symbol != null { return symbol; }
        if this.parent == null { return null; }
        this.parent->Lookup(name)
    }
}

class ModuleInfo {
    pub name: String,
    pub item: *mut ASTModuleItem = null,
    pub symbol: *mut Symbol = null,
    pub scope: *mut Scope = null,
    pub ports: Vector<*mut Symbol>,
    pub signals: Vector<*mut Symbol>,
    pub enums: Vector<*mut EnumInfo>,
    pub clock: *mut Symbol = null,
    pub reset: *mut Symbol = null,
    pub ports_resolved: bool = false;

    ModuleInfo(&mut this, name: &String, item: *mut ASTModuleItem) {
        (this.name, this.item) = (name, item);
    }

    pub fn FindPort(&this, name: &String) -> *mut Symbol {
        for port in this.ports {
            if port->name == name { return port; }
        }

        null
    }
}
