#[include "std/str", "std/vec", "std/map", "std/arena", "std/opt", "src/Logger.zir", "src/AST.zir", "src/Semantic.zir" : *]

const MAX_WIDTH: i64 = 4096;
const MAX_LENGTH: i64 = 16777216;

enum Context: u8 {
    Module, Comb, Seq
}

fn Quote(name: &String) -> String {
    "'" + name + "'"
}

fn Clog2(value: i64) -> i64 {
    let mut result: i64 = 0;
    let mut power: i64 = 1;

    while power < value {
        power <<= 1;
        result += 1;
    }

    result
}

fn Wrap(value: i64, target: *mut Type) -> i64 {
    if !target->IsBits() || target->width >= 63 { return value; }
    let width = target->width as i64;
    let mut result = value & (((1 as i64) << width) - 1);

    if target->signed && ((result >> (width - 1)) & 1) == 1 {
        result -= (1 as i64) << width;
    }

    result
}

fn Fits(value: i64, target: *mut Type) -> bool {
    if !target->IsBits() { return false; }
    let width = target->width as i64;

    if target->signed {
        if width >= 64 { return true; }
        let limit = (1 as i64) << (width - 1);
        return value >= -limit && value < limit;
    }

    if value < 0 { return false; }
    if width >= 63 { return true; }
    value < ((1 as i64) << width)
}

fn Union(a: &Vector<*mut Symbol>, b: &Vector<*mut Symbol>) -> Vector<*mut Symbol> {
    let mut result = Vector<*mut Symbol>(a);

    for symbol in b {
        if !result.Contains(symbol) { result.PushBack(symbol); }
    }

    result
}

fn Intersect(a: &Vector<*mut Symbol>, b: &Vector<*mut Symbol>) -> Vector<*mut Symbol> {
    let mut result = Vector<*mut Symbol>();

    for symbol in a {
        if b.Contains(symbol) { result.PushBack(symbol); }
    }

    result
}

class Checker {
    arena: Arena,
    pub global: *mut Scope = null,
    pub enums: Vector<*mut EnumInfo>,
    pub modules: Vector<*mut ModuleInfo>,
    pub root: *mut ASTFile = null,
    error_type: *mut Type = null,
    integer_type: *mut Type = null,
    bool_type: *mut Type = null,
    clock_type: *mut Type = null,
    reset_type: *mut Type = null,
    current: *mut ModuleInfo = null,
    block: *mut ASTItem = null;

    Checker(&mut this) {
        this.global = this.arena.New<Scope>(null);
        this.error_type = this.arena.New<Type>(TypeKind::Error);
        this.integer_type = this.arena.New<Type>(TypeKind::Integer);
        this.clock_type = this.arena.New<Type>(TypeKind::Clock);
        this.reset_type = this.arena.New<Type>(TypeKind::Reset);
        this.bool_type = this.MakeBits(1, false);
    }

    fn Error(&this, message: &String, span: SourceSpan) {
        Logger::Log(message, span, LogSeverity::Error);
    }

    fn Error(&this, message: *i8, span: SourceSpan) {
        Logger::Log(message, span, LogSeverity::Error);
    }

    fn Note(&this, message: &String, span: SourceSpan) {
        Logger::Log(message, span, LogSeverity::Info);
    }

    fn Note(&this, message: *i8, span: SourceSpan) {
        Logger::Log(message, span, LogSeverity::Info);
    }

    pub fn MakeBits(&mut this, width: u32, signed: bool) -> *mut Type {
        let result = this.arena.New<Type>(TypeKind::Bits);
        (result->width, result->signed) = (width, signed);
        result
    }

    fn ValueType(&this, _type: *mut Type) -> *mut Type {
        if _type->IsReset() { this.bool_type } else { _type }
    }

    fn ParseBuiltinWidth(&this, name: &String) -> i64 {
        if name.Length() < 2 || (name[0] != 'u' && name[0] != 'i') || name[1] == '0' { return -1; }
        let mut width: i64 = 0;

        for i in 1..name.Length() {
            let character = name[i];
            if character < '0' || character > '9' { return -1; }
            width = width * 10 + (character - '0') as i64;
            if width > MAX_WIDTH { return MAX_WIDTH + 1; }
        }

        width
    }

    fn ResolveType(&mut this, ast: *mut ASTType, scope: *mut Scope) -> *mut Type {
        if ast == null { return this.error_type; }

        match ast->kind {
            ASTTypeKind::Named => {
                let name = (ast as *mut ASTNamedType)->name;
                if name == "bool" { return this.bool_type; }
                if name == "clock" { return this.clock_type; }
                if name == "reset" { return this.reset_type; }
                let width = this.ParseBuiltinWidth(name);

                if width > MAX_WIDTH {
                    this.Error("Bit vectors can be at most " + String::FromInteger(MAX_WIDTH) + " bits wide.", ast->span);
                    return this.error_type;
                }

                if width > 0 {
                    return this.MakeBits(width as u32, name[0] == 'i');
                }

                let symbol = scope->Lookup(name);

                if symbol == null {
                    this.Error("Cannot find type " + Quote(name) + " in this scope.", ast->span);
                    return this.error_type;
                }

                if !this.ResolveSymbol(symbol) { return this.error_type; }

                match symbol->kind {
                    SymbolKind::Alias => symbol->_type,
                    SymbolKind::Enumeration => symbol->enumeration->_type,
                    _ => {
                        this.Error(Quote(name) + " is a " + symbol->kind.Describe() + ", not a type.", ast->span);
                        this.error_type
                    }
                }
            },
            ASTTypeKind::Sized => {
                let sized = ast as *mut ASTSizedType;

                match this.EvalConstant(sized->width, scope) {
                    Option<i64>::Some(width) => {
                        if width < 1 || width > MAX_WIDTH {
                            this.Error("Width must be between 1 and " + String::FromInteger(MAX_WIDTH) + ", found " + String::FromInteger(width) + ".", sized->width->span);
                            return this.error_type;
                        }

                        this.MakeBits(width as u32, sized->signed)
                    },
                    Option<i64>::None => this.error_type
                }
            },
            ASTTypeKind::Array => {
                let array = ast as *mut ASTArrayType;
                let element = this.ResolveType(array->element, scope);
                if element->IsError() { return this.error_type; }

                if !element->IsBits() && !element->IsEnum() {
                    this.Error("Memory elements must be bit vectors or enums, found " + Quote(element->Describe()) + ".", array->element->span);
                    return this.error_type;
                }

                match this.EvalConstant(array->length, scope) {
                    Option<i64>::Some(length) => {
                        if length < 1 || length > MAX_LENGTH {
                            this.Error("Memory length must be between 1 and " + String::FromInteger(MAX_LENGTH) + ", found " + String::FromInteger(length) + ".", array->length->span);
                            return this.error_type;
                        }

                        let result = this.arena.New<Type>(TypeKind::Array);
                        (result->element, result->length) = (element, length as u32);
                        result
                    },
                    Option<i64>::None => this.error_type
                }
            }
        }
    }

    fn IsBuiltinName(&mut this, name: &String) -> bool {
        name == "bool" || name == "clock" || name == "reset" || this.ParseBuiltinWidth(name) > 0
    }

    fn Define(&mut this, scope: *mut Scope, symbol: *mut Symbol) {
        this.DefineAs(scope, symbol->name, symbol);
    }

    fn DefineAs(&mut this, scope: *mut Scope, key: &String, symbol: *mut Symbol) -> bool {
        let existing = scope->LookupLocal(key);

        if existing != null {
            this.Error(Quote(key) + " is already defined.", symbol->span);
            this.Note("Previous definition is here.", existing->span);
            return false;
        }

        if this.IsBuiltinName(key) {
            this.Error(Quote(key) + " is a built-in type name and cannot be redefined.", symbol->span);
            return false;
        }

        symbol->scope = scope;
        scope->symbols[key] = symbol;
        true
    }

    fn DefineMember(&mut this, scope: *mut Scope, key: &String, symbol: *mut Symbol) {
        if !this.DefineAs(scope, key, symbol) || !scope->iteration { return; }
        let parent = scope->parent;
        let mut group = parent->LookupLocal(key);

        if group == null {
            group = this.NewSymbol(SymbolKind::Group, key, symbol->span, scope->owner);
            (group->member, group->value, group->resolved) = (symbol->kind, scope->start, true);
            group->_type = this.integer_type;
            this.DefineMember(parent, key, group);
        } else if group->kind != SymbolKind::Group || group->node != scope->owner {
            this.Error(Quote(key) + " is already defined.", symbol->span);
            this.Note("Previous definition is here.", group->span);
            return;
        }

        group->elements.PushBack(symbol);
    }

    fn NewSymbol(&mut this, kind: SymbolKind, name: &String, span: SourceSpan, node: *mut ASTNode) -> *mut Symbol {
        let symbol = this.arena.New<Symbol>(kind, name, span);
        symbol->node = node;
        symbol
    }

    fn Declare(&mut this, item: *mut ASTItem, scope: *mut Scope, owner: *mut ModuleInfo) {
        match item->kind {
            ASTItemKind::Const => {
                let constant = item as *mut ASTConstItem;
                constant->symbol = this.NewSymbol(SymbolKind::Constant, constant->name, item->span, item);
                this.Define(scope, constant->symbol);
            },
            ASTItemKind::Type => {
                let alias = item as *mut ASTTypeItem;
                alias->symbol = this.NewSymbol(SymbolKind::Alias, alias->name, item->span, item);
                this.Define(scope, alias->symbol);
            },
            ASTItemKind::Enum => {
                let enumeration = item as *mut ASTEnumItem;
                let symbol = this.NewSymbol(SymbolKind::Enumeration, enumeration->name, item->span, item);
                let info = this.arena.New<EnumInfo>(enumeration->name, enumeration);
                info->local = owner != null;
                info->_type = this.arena.New<Type>(TypeKind::Enum);
                info->_type->enumeration = info;
                symbol->enumeration = info;
                enumeration->symbol = symbol;
                this.Define(scope, symbol);

                if owner == null {
                    this.enums.PushBack(info);
                } else {
                    owner->enums.PushBack(info);
                }
            },
            ASTItemKind::Module => {
                let module = item as *mut ASTModuleItem;
                let symbol = this.NewSymbol(SymbolKind::Module, module->name, item->span, item);
                let info = this.arena.New<ModuleInfo>(module->name, module);
                (info->symbol, symbol->module, module->info) = (symbol, info, info);
                this.Define(scope, symbol);
                this.modules.PushBack(info);
            },
            ASTItemKind::Signal => {
                let signal = item as *mut ASTSignalItem;

                let kind = match signal->signal {
                    ASTSignalKind::Let => if signal->value != null && signal->value->kind == ASTExpressionKind::Instance { SymbolKind::Instance } else { SymbolKind::Let },
                    ASTSignalKind::Wire => SymbolKind::Wire,
                    ASTSignalKind::Reg => SymbolKind::Register
                };

                let symbol = this.NewSymbol(kind, signal->name, item->span, item);
                symbol->registered = kind == SymbolKind::Register;
                signal->symbol = symbol;
                this.Define(scope, symbol);
                owner->signals.PushBack(symbol);
            },
            _ => {}
        }
    }

    fn DeclareElement(&mut this, item: *mut ASTItem, scope: *mut Scope, owner: *mut ModuleInfo, suffix: &String) {
        if !scope->iteration {
            this.Declare(item, scope, owner);
            return;
        }

        match item->kind {
            ASTItemKind::Const => this.Declare(item, scope, owner),
            ASTItemKind::Signal => {
                let signal = item as *mut ASTSignalItem;

                let kind = match signal->signal {
                    ASTSignalKind::Let => if signal->value != null && signal->value->kind == ASTExpressionKind::Instance { SymbolKind::Instance } else { SymbolKind::Let },
                    ASTSignalKind::Wire => SymbolKind::Wire,
                    ASTSignalKind::Reg => SymbolKind::Register
                };

                let symbol = this.NewSymbol(kind, signal->name + suffix, item->span, item);
                symbol->registered = kind == SymbolKind::Register;
                signal->symbol = symbol;
                this.DefineMember(scope, signal->name, symbol);
                owner->signals.PushBack(symbol);
            },
            _ => {}
        }
    }

    fn DeclareItems(&mut this, items: &Vector<*mut ASTItem>, scope: *mut Scope, owner: *mut ModuleInfo, suffix: &String, result: &mut Vector<*mut ASTItem>, scopes: &mut Vector<*mut Scope>) {
        for child in items {
            if child->kind == ASTItemKind::Const || child->kind == ASTItemKind::Type || child->kind == ASTItemKind::Enum {
                this.DeclareElement(child, scope, owner, suffix);
            }
        }

        for child in items {
            match child->kind {
                ASTItemKind::For => {
                    let loop_item = child as *mut ASTForItem;
                    this.ExpandFor(loop_item, scope, owner, suffix);
                    result += loop_item->expanded;
                    scopes += loop_item->scopes;
                },
                ASTItemKind::If => {
                    let conditional = child as *mut ASTIfItem;
                    this.ExpandIf(conditional, scope, owner, suffix);
                    result += conditional->expanded;
                    scopes += conditional->scopes;
                },
                ASTItemKind::Const | ASTItemKind::Type | ASTItemKind::Enum => {
                    if !scope->iteration || child->kind == ASTItemKind::Const {
                        result.PushBack(child);
                        scopes.PushBack(scope);
                    }
                },
                _ => {
                    this.DeclareElement(child, scope, owner, suffix);
                    result.PushBack(child);
                    scopes.PushBack(scope);
                }
            }
        }
    }

    fn ExpandFor(&mut this, item: *mut ASTForItem, scope: *mut Scope, owner: *mut ModuleInfo, suffix: &String) {
        let first = match this.EvalConstant(item->start, scope) { Option<i64>::Some(value) => value, Option<i64>::None => { return; } };
        let last = match this.EvalConstant(item->end, scope) { Option<i64>::Some(value) => value, Option<i64>::None => { return; } };

        if last - first > 4096 {
            this.Error("A module-level 'for' loop can have at most 4096 iterations.", item->span);
            return;
        }

        for child in item->items {
            if child->kind == ASTItemKind::Type || child->kind == ASTItemKind::Enum {
                this.Error("Types and enums cannot be declared inside a module-level 'for'; declare them outside the loop.", child->span);
            }
        }

        let mut value = first;

        while value < last {
            let inner = this.arena.New<Scope>(scope);
            (inner->iteration, inner->start, inner->owner) = (true, first, item as *mut ASTNode);
            let variable = this.NewSymbol(SymbolKind::Constant, item->variable, item->span, item);
            (variable->value, variable->_type, variable->resolved) = (value, this.integer_type, true);
            this.Define(inner, variable);
            let mut body = Vector<*mut ASTItem>();

            for child in item->items {
                body.PushBack(this.CloneItem(child));
            }

            this.DeclareItems(body, inner, owner, suffix + "_" + String::FromInteger(value), item->expanded, item->scopes);
            value += 1;
        }
    }

    fn ExpandIf(&mut this, item: *mut ASTIfItem, scope: *mut Scope, owner: *mut ModuleInfo, suffix: &String) {
        let condition = match this.EvalConstant(item->condition, scope) { Option<i64>::Some(value) => value, Option<i64>::None => { return; } };
        let chosen = if condition != 0 { item->then } else { item->otherwise };
        this.DeclareItems(chosen, scope, owner, suffix, item->expanded, item->scopes);
    }

    fn CloneItem(&mut this, item: *mut ASTItem) -> *mut ASTItem {
        let span = item->span;

        match item->kind {
            ASTItemKind::Const => {
                let constant = item as *mut ASTConstItem;
                this.arena.New<ASTConstItem>(constant->name, constant->declared, this.CloneExpression(constant->value), span)
            },
            ASTItemKind::Signal => {
                let signal = item as *mut ASTSignalItem;
                this.arena.New<ASTSignalItem>(signal->signal, signal->name, signal->declared, this.CloneExpression(signal->value), span)
            },
            ASTItemKind::Assign => {
                let assign = item as *mut ASTAssignItem;
                this.arena.New<ASTAssignItem>(this.CloneExpression(assign->target), this.CloneExpression(assign->value), span)
            },
            ASTItemKind::Comb => this.arena.New<ASTCombItem>(this.CloneBlock((item as *mut ASTCombItem)->body), span),
            ASTItemKind::Seq => {
                let seq = item as *mut ASTSeqItem;
                this.arena.New<ASTSeqItem>(this.CloneExpression(seq->clock), this.CloneExpression(seq->reset), this.CloneBlock(seq->body), span)
            },
            ASTItemKind::For => {
                let loop_item = item as *mut ASTForItem;
                let result = this.arena.New<ASTForItem>(loop_item->variable, this.CloneExpression(loop_item->start), this.CloneExpression(loop_item->end), span);

                for child in loop_item->items {
                    result->items.PushBack(this.CloneItem(child));
                }

                result
            },
            ASTItemKind::If => {
                let conditional = item as *mut ASTIfItem;
                let result = this.arena.New<ASTIfItem>(this.CloneExpression(conditional->condition), span);

                for child in conditional->then {
                    result->then.PushBack(this.CloneItem(child));
                }

                for child in conditional->otherwise {
                    result->otherwise.PushBack(this.CloneItem(child));
                }

                result
            },
            _ => item
        }
    }

    fn ResolveSymbol(&mut this, symbol: *mut Symbol) -> bool {
        if symbol->resolved { return !symbol->_type->IsError(); }

        if symbol->resolving {
            this.Error(Quote(symbol->name) + " depends on itself.", symbol->span);
            symbol->_type = this.error_type;
            return false;
        }

        symbol->resolving = true;
        symbol->_type = this.error_type;

        match symbol->kind {
            SymbolKind::Constant => this.ResolveConstant(symbol),
            SymbolKind::Alias => {
                symbol->_type = this.ResolveType((symbol->node as *mut ASTTypeItem)->aliased, symbol->scope);
            },
            SymbolKind::Enumeration => this.ResolveEnum(symbol),
            SymbolKind::Module => this.ResolvePorts(symbol->module),
            SymbolKind::Let | SymbolKind::Wire | SymbolKind::Register => this.ResolveSignal(symbol),
            SymbolKind::Instance => this.ResolveInstance(symbol),
            SymbolKind::Port => {},
            SymbolKind::Group => { symbol->_type = this.integer_type; }
        }

        (symbol->resolving, symbol->resolved) = (false, true);
        !symbol->_type->IsError()
    }

    fn ResolveConstant(&mut this, symbol: *mut Symbol) {
        let item = symbol->node as *mut ASTConstItem;
        let mut _type = this.integer_type;

        if item->declared != null {
            _type = this.ResolveType(item->declared, symbol->scope);
            if _type->IsError() { return; }

            if !_type->IsBits() {
                this.Error("Constants must be integers or bit vectors, found " + Quote(_type->Describe()) + ".", item->declared->span);
                return;
            }
        }

        match this.EvalConstant(item->value, symbol->scope) {
            Option<i64>::Some(value) => {
                if !_type->IsInteger() && !Fits(value, _type) {
                    this.Error("Constant " + String::FromInteger(value) + " does not fit in " + Quote(_type->Describe()) + ".", item->value->span);
                    return;
                }

                (symbol->value, symbol->_type) = (value, _type);
            },
            Option<i64>::None => {}
        }
    }

    fn ResolveEnum(&mut this, symbol: *mut Symbol) {
        let info = symbol->enumeration;
        let item = info->item;
        let mut width: i64 = -1;

        if item->base != null {
            let base = this.ResolveType(item->base, symbol->scope);
            if base->IsError() { return; }

            if !base->IsBits() || base->signed {
                this.Error("The base type of an enum must be an unsigned bit vector, found " + Quote(base->Describe()) + ".", item->base->span);
                return;
            }

            width = base->width as i64;
        }

        if item->variants.Empty() {
            this.Error("Enum " + Quote(info->name) + " has no variants.", item->span);
            return;
        }

        let mut next: i64 = 0;
        let mut largest: i64 = 0;
        let mut valid = true;

        for variant in item->variants {
            let mut value = next;

            if variant->value != null {
                match this.EvalConstant(variant->value, symbol->scope) {
                    Option<i64>::Some(result) => { value = result; },
                    Option<i64>::None => {
                        valid = false;
                        continue;
                    }
                }
            }

            if value < 0 {
                this.Error("Enum values cannot be negative.", variant->span);
                valid = false;
            }

            if info->Find(variant->name) >= 0 {
                this.Error("Variant " + Quote(variant->name) + " is already defined in " + Quote(info->name) + ".", variant->span);
                valid = false;
            }

            let duplicate = info->FindValue(value);

            if duplicate >= 0 {
                this.Error("Variant " + Quote(variant->name) + " has the same value as " + Quote(info->names[duplicate as usize]) + ".", variant->span);
                valid = false;
            }

            info->names.PushBack(variant->name);
            info->values.PushBack(value);
            if value > largest { largest = value; }
            next = value + 1;
        }

        if !valid { return; }

        if width < 0 {
            width = Clog2(largest + 1);
            if width < 1 { width = 1; }
        } else if width < 63 && largest >= ((1 as i64) << width) {
            this.Error("Enum " + Quote(info->name) + " has a value that does not fit in " + String::FromInteger(width) + " bits.", item->span);
            return;
        }

        info->width = width as u32;
        symbol->_type = info->_type;
    }

    fn ResolvePorts(&mut this, module: *mut ModuleInfo) {
        let item = module->item;
        module->scope = this.arena.New<Scope>(this.global);
        let mut valid = true;

        if !item->external && !item->parameters.Empty() {
            this.Error("Only extern modules can have parameters.", item->span);
            valid = false;
        }

        for i in 0..item->parameters.Length() {
            for j in 0..i {
                if item->parameters[i] == item->parameters[j] {
                    this.Error("Parameter " + Quote(item->parameters[i]) + " is declared more than once.", item->span);
                    valid = false;
                }
            }
        }

        for port in item->ports {
            if port->condition != null {
                match this.EvalConstant(port->condition, this.global) {
                    Option<i64>::Some(value) => {
                        if value == 0 {
                            module->disabled.PushBack(port->name);
                            continue;
                        }
                    },
                    Option<i64>::None => {
                        valid = false;
                        continue;
                    }
                }
            }

            if !item->external && port->declared->kind == ASTTypeKind::Array {
                if !this.ResolvePortGroup(module, port) { valid = false; }
                continue;
            }

            let symbol = this.NewSymbol(SymbolKind::Port, port->name, port->span, port);
            let input = port->input || port->bidirectional;
            (symbol->input, symbol->output, symbol->registered, symbol->bidirectional) = (input, !input, port->registered, port->bidirectional);
            symbol->_type = this.ResolveType(port->declared, this.global);
            (symbol->resolved, symbol->init) = (true, port->init);
            port->symbol = symbol;

            if !item->external || !this.IsBuiltinName(port->name) {
                this.Define(module->scope, symbol);
            } else if module->FindPort(port->name) != null {
                this.Error(Quote(port->name) + " is already defined.", port->span);
            }

            module->ports.PushBack(symbol);

            if symbol->_type->IsError() {
                valid = false;
                continue;
            }

            if symbol->_type->IsArray() {
                this.Error("Memories cannot be used as ports.", port->declared->span);
                valid = false;
            }

            if port->registered && (symbol->_type->IsClock() || symbol->_type->IsReset()) {
                this.Error("A " + Quote(symbol->_type->Describe()) + " port cannot be a register.", port->declared->span);
                valid = false;
            }

            if port->bidirectional && (!symbol->_type->IsBits() || port->init != null) {
                this.Error("An 'inout' port must be a plain bit vector without an initial value.", port->declared->span);
                valid = false;
            }

            if input {
                symbol->driver = DriverKind::Input;
                if symbol->_type->IsClock() && module->clock == null { module->clock = symbol; }
                if symbol->_type->IsReset() && module->reset == null { module->reset = symbol; }
            }
        }

        module->ports_resolved = true;
        module->symbol->_type = if valid { this.integer_type } else { this.error_type };
    }

    fn ResolvePortGroup(&mut this, module: *mut ModuleInfo, port: *mut ASTPort) -> bool {
        let _type = this.ResolveType(port->declared, this.global);
        if _type->IsError() { return false; }

        if port->bidirectional {
            this.Error("An 'inout' port cannot be an array.", port->declared->span);
            return false;
        }

        let input = port->input;
        let group = this.NewSymbol(SymbolKind::Group, port->name, port->span, port);
        (group->member, group->resolved, group->_type) = (SymbolKind::Port, true, this.integer_type);
        port->symbol = group;
        this.Define(module->scope, group);
        module->port_groups.PushBack(group);

        for k in 0..(_type->length as i64) {
            let element = this.NewSymbol(SymbolKind::Port, port->name + "_" + String::FromInteger(k), port->span, port);
            (element->input, element->output, element->registered) = (input, !input, port->registered);
            (element->_type, element->resolved, element->init, element->scope) = (_type->element, true, port->init, module->scope);
            if input { element->driver = DriverKind::Input; }
            group->elements.PushBack(element);
            module->ports.PushBack(element);
        }

        true
    }

    fn HoldsInstances(&this, group: *mut Symbol) -> bool {
        if group->elements.Empty() { return false; }
        let first = group->elements[0];
        first->kind == SymbolKind::Instance || (first->kind == SymbolKind::Group && this.HoldsInstances(first))
    }

    fn GroupType(&mut this, group: *mut Symbol, instance: *mut Symbol, span: SourceSpan) -> *mut Type {
        if group->elements.Empty() { return this.error_type; }
        let mut element: *mut Type = null;

        for member in group->elements {
            let mut current = this.error_type;

            if member->kind == SymbolKind::Group {
                current = this.GroupType(member, instance, span);
            } else if this.ResolveSymbol(member) {
                current = member->_type;
            }

            if current->IsError() { return this.error_type; }

            if element == null {
                element = current;
            } else if !SameType(element, current) {
                this.Error("The elements of " + Quote(group->name) + " have different types, " + Quote(element->Describe()) + " and " + Quote(current->Describe()) + ".", span);
                return this.error_type;
            }
        }

        let result = this.arena.New<Type>(TypeKind::Group);
        (result->element, result->length, result->group, result->instance) = (element, group->elements.Length() as u32, group, instance);
        result
    }

    fn SelectElement(&mut this, group: *mut Symbol, index: *mut ASTExpression, scope: *mut Scope) -> *mut Symbol {
        let value = match this.EvalConstant(index, scope) { Option<i64>::Some(value) => value, Option<i64>::None => { return null; } };
        let position = value - group->value;

        if position < 0 || position >= group->elements.Length() as i64 {
            this.Error("Index " + String::FromInteger(value) + " is out of range for " + Quote(group->name) + ", which has elements " +
                String::FromInteger(group->value) + " to " + String::FromInteger(group->value + group->elements.Length() as i64 - 1) + ".", index->span);
            return null;
        }

        group->elements[position as usize]
    }

    fn GroupElement(&mut this, base: *mut ASTExpression, _type: *mut Type, position: i64) -> *mut ASTExpression {
        let element = _type->group->elements[position as usize];

        if _type->port != null {
            let member = this.arena.New<ASTMemberExpression>(base, _type->port->name, base->span);
            (member->instance, member->port, member->resolved) = (element, _type->port, _type->port->_type);
            return member;
        }

        if _type->instance != null {
            let member = this.arena.New<ASTMemberExpression>(base, element->name, base->span);
            (member->instance, member->port, member->resolved) = (_type->instance, element, element->_type);
            return member;
        }

        let path = this.MakePath(element->name, base->span);
        path->symbol = element;
        path->resolved = if element->kind == SymbolKind::Group { this.GroupType(element, null, base->span) } else { element->_type };
        path
    }

    fn InstanceGroupOf(&mut this, expression: *mut ASTExpression, scope: *mut Scope) -> *mut Symbol {
        if expression->kind == ASTExpressionKind::Path && (expression as *mut ASTPathExpression)->segments.Length() == 1 {
            let name = (expression as *mut ASTPathExpression)->segments[0];
            let symbol = scope->Lookup(name);

            if symbol == null {
                this.Error("Cannot find " + Quote(name) + " in this scope.", expression->span);
                return null;
            }

            if symbol->kind != SymbolKind::Group || !this.HoldsInstances(symbol) {
                this.Error(Quote(name) + " is a " + symbol->kind.Describe() + ", not an array of instances.", expression->span);
                return null;
            }

            return symbol;
        }

        if expression->kind == ASTExpressionKind::Index {
            let index = expression as *mut ASTIndexExpression;
            let outer = this.InstanceGroupOf(index->base, scope);
            if outer == null { return null; }
            let element = this.SelectElement(outer, index->index, scope);
            if element == null { return null; }

            if element->kind != SymbolKind::Group {
                this.Error("Too many indices for " + Quote(outer->name) + ".", expression->span);
                return null;
            }

            return element;
        }

        this.Error("Only instance outputs can be accessed with '.'.", expression->span);
        null
    }

    fn InstanceOf(&mut this, base: *mut ASTExpression, scope: *mut Scope) -> *mut Symbol {
        if base->kind == ASTExpressionKind::Index {
            let index = base as *mut ASTIndexExpression;
            let group = this.InstanceGroupOf(index->base, scope);
            if group == null { return null; }
            let element = this.SelectElement(group, index->index, scope);
            if element == null { return null; }

            if element->kind != SymbolKind::Instance {
                this.Error(Quote(group->name) + " has more dimensions; select one instance with an index for each.", base->span);
                return null;
            }

            base->resolved = this.error_type;
            return element;
        }

        if base->kind != ASTExpressionKind::Path || (base as *mut ASTPathExpression)->segments.Length() != 1 {
            this.Error("Only instance outputs can be accessed with '.'.", base->span);
            return null;
        }

        let name = (base as *mut ASTPathExpression)->segments[0];
        let symbol = scope->Lookup(name);

        if symbol == null {
            this.Error("Cannot find " + Quote(name) + " in this scope.", base->span);
            return null;
        }

        if symbol->kind == SymbolKind::Group && this.HoldsInstances(symbol) {
            this.Error(Quote(name) + " is an array of instances; select one with '" + name + "[k]." + "<port>'.", base->span);
            return null;
        }

        if symbol->kind != SymbolKind::Instance {
            this.Error(Quote(name) + " is a " + symbol->kind.Describe() + ", not an instance.", base->span);
            return null;
        }

        base->resolved = this.error_type;
        symbol
    }

    fn ResolveSignal(&mut this, symbol: *mut Symbol) {
        let item = symbol->node as *mut ASTSignalItem;
        let scope = symbol->scope;

        if item->signal == ASTSignalKind::Let {
            symbol->driver = DriverKind::Assign;
            (symbol->driver_node, symbol->driver_span) = (item, item->span);

            if item->declared != null {
                let _type = this.ResolveType(item->declared, scope);
                if _type->IsError() { return; }

                if _type->IsArray() {
                    this.Error("Memories can only be declared with 'reg'.", item->declared->span);
                    return;
                }

                symbol->_type = _type;
                this.CheckExpression(item->value, scope, Context::Module, _type);
                this.Coerce(item->value, _type);
                return;
            }

            let _type = this.CheckExpression(item->value, scope, Context::Module, null);
            if _type->IsError() { return; }

            if _type->IsGroup() {
                this.Error("An array cannot be stored in a 'let'; index it or connect it to an array port.", item->span);
                return;
            }

            if _type->IsInteger() {
                this.Error("Cannot infer the width of " + Quote(symbol->name) + "; add a type such as 'let " + symbol->name + ": u8 = ...' or use 'const'.", item->span);
                return;
            }

            symbol->_type = _type;
            return;
        }

        let _type = this.ResolveType(item->declared, scope);
        if _type->IsError() { return; }

        if item->signal == ASTSignalKind::Wire {
            if _type->IsArray() {
                this.Error("Memories can only be declared with 'reg'.", item->declared->span);
                return;
            }

            symbol->_type = _type;
            return;
        }

        if _type->IsClock() || _type->IsReset() {
            this.Error("A register cannot have the type " + Quote(_type->Describe()) + ".", item->declared->span);
            return;
        }

        symbol->_type = _type;

        if item->value != null {
            if _type->IsArray() {
                let call = item->value as *mut ASTCallExpression;

                if item->value->kind != ASTExpressionKind::Call || call->name != "readmemh" || call->arguments.Length() != 1 ||
                    call->arguments[0]->kind != ASTExpressionKind::String {
                    this.Error("A memory can only be initialized from a file with 'readmemh(\"file.hex\")'.", item->value->span);
                    return;
                }

                symbol->memory_file = (call->arguments[0] as *mut ASTStringLiteral)->text;
                return;
            }

            this.CheckInitial(item->value, scope, _type);
            symbol->init = item->value;
        }
    }

    fn CheckInitial(&mut this, value: *mut ASTExpression, scope: *mut Scope, _type: *mut Type) {
        if value->kind == ASTExpressionKind::Call && (value as *mut ASTCallExpression)->name == "readmemh" {
            this.Error("Only memories can be initialized with 'readmemh'; declare it as 'reg name: [T; N]'.", value->span);
            return;
        }

        let actual = this.CheckExpression(value, scope, Context::Module, _type);
        if actual->IsError() { return; }

        if !value->constant {
            this.Error("The initial value of a register must be a constant.", value->span);
            return;
        }

        this.Coerce(value, _type);
    }

    fn InstanceModule(&mut this, symbol: *mut Symbol) -> *mut ModuleInfo {
        if symbol->module != null { return symbol->module; }
        let instance = (symbol->node as *mut ASTSignalItem)->value as *mut ASTInstanceExpression;
        let module_symbol = this.global->Lookup(instance->module);

        if module_symbol == null || module_symbol->kind != SymbolKind::Module {
            this.Error("Cannot find module " + Quote(instance->module) + ".", instance->span);
            return null;
        }

        if !this.ResolveSymbol(module_symbol) { return null; }

        if module_symbol->module == this.current {
            this.Error("Module " + Quote(instance->module) + " cannot instantiate itself.", instance->span);
            return null;
        }

        symbol->module = module_symbol->module;
        symbol->module
    }

    fn ResolveInstance(&mut this, symbol: *mut Symbol) {
        let item = symbol->node as *mut ASTSignalItem;
        let instance = item->value as *mut ASTInstanceExpression;
        let scope = symbol->scope;
        (instance->target, symbol->instance) = (symbol, instance);
        let module = this.InstanceModule(symbol);
        if module == null { return; }
        let mut connected = Vector<*mut Symbol>();
        let mut valid = true;
        let mut assigned = Vector<String>();

        for parameter in instance->parameters {
            if !module->item->parameters.Contains(parameter->name) {
                this.Error("Module " + Quote(module->name) + " has no parameter named " + Quote(parameter->name) + ".", parameter->span);
                valid = false;
                continue;
            }

            if assigned.Contains(parameter->name) {
                this.Error("Parameter " + Quote(parameter->name) + " is set more than once.", parameter->span);
                valid = false;
                continue;
            }

            assigned.PushBack(parameter->name);

            if parameter->value->kind == ASTExpressionKind::String {
                parameter->text = "\"" + (parameter->value as *mut ASTStringLiteral)->text + "\"";
                continue;
            }

            match this.EvalConstant(parameter->value, scope) {
                Option<i64>::Some(value) => { parameter->text = String::FromInteger(value); },
                Option<i64>::None => { valid = false; }
            }
        }

        let mut expanded = Vector<*mut ASTConnection>();

        for connection in instance->connections {
            if module->disabled.Contains(connection->name) { continue; }
            let port = module->FindPort(connection->name);

            if port == null {
                let group = module->FindPortGroup(connection->name);

                if group == null {
                    this.Error("Module " + Quote(module->name) + " has no port named " + Quote(connection->name) + ".", connection->span);
                    valid = false;
                    continue;
                }

                if !group->elements[0]->input {
                    this.Error(Quote(connection->name) + " is an output of " + Quote(module->name) + "; read it as '" + symbol->name + "." + connection->name + "' instead.", connection->span);
                    valid = false;
                    continue;
                }

                if connected.Contains(group->elements[0]) {
                    this.Error("Port " + Quote(connection->name) + " is connected more than once.", connection->span);
                    valid = false;
                    continue;
                }

                for element in group->elements { connected.PushBack(element); }
                let expected = this.GroupType(group, null, connection->span);
                let actual = this.CheckExpression(connection->value, scope, Context::Module, null);
                if expected->IsError() || actual->IsError() { valid = false; continue; }

                if !actual->IsGroup() || !SameType(actual, expected) {
                    this.Error("Port " + Quote(connection->name) + " expects " + Quote(expected->Describe()) + ", found " + Quote(actual->Describe()) + ".", connection->value->span);
                    valid = false;
                    continue;
                }

                for k in 0..group->elements.Length() {
                    let element = group->elements[k];
                    let value = this.GroupElement(connection->value, actual, k as i64);
                    let link = this.arena.New<ASTConnection>(element->name, value, connection->span);
                    link->port = element;
                    expanded.PushBack(link);
                }

                continue;
            }

            if !port->input {
                this.Error(Quote(connection->name) + " is an output of " + Quote(module->name) + "; read it as '" + symbol->name + "." + connection->name + "' instead.", connection->span);
                valid = false;
                continue;
            }

            if connected.Contains(port) {
                this.Error("Port " + Quote(connection->name) + " is connected more than once.", connection->span);
                valid = false;
                continue;
            }

            connected.PushBack(port);
            connection->port = port;
            if !this.CheckConnection(connection->value, scope, port) { valid = false; }
        }

        instance->connections += expanded;

        for group in module->port_groups {
            if group->elements[0]->input && !connected.Contains(group->elements[0]) {
                this.Error("Missing connection for input " + Quote(group->name) + " of " + Quote(module->name) + ".", instance->span);
                valid = false;
                for element in group->elements { connected.PushBack(element); }
            }
        }

        for port in module->ports {
            if !port->input || connected.Contains(port) { continue; }
            let mut fallback: *mut Symbol = null;
            if port->_type->IsClock() { fallback = this.current->clock; }
            if port->_type->IsReset() { fallback = this.current->reset; }

            if fallback == null {
                this.Error("Missing connection for ".ToString() + (if port->bidirectional { "inout " } else { "input " }) + Quote(port->name) + " of " + Quote(module->name) + ".", instance->span);
                valid = false;
                continue;
            }

            let path = this.MakePath(fallback->name, instance->span);
            let connection = this.arena.New<ASTConnection>(port->name, path, instance->span);
            connection->port = port;
            this.CheckConnection(path, scope, port);
            instance->connections.PushBack(connection);
        }

        symbol->_type = if valid { this.integer_type } else { this.error_type };
    }

    fn CheckConnection(&mut this, value: *mut ASTExpression, scope: *mut Scope, port: *mut Symbol) -> bool {
        if port->bidirectional {
            let path = value as *mut ASTPathExpression;
            let symbol = if value->kind == ASTExpressionKind::Path && path->segments.Length() == 1 { scope->Lookup(path->segments[0]) } else { null };

            if symbol == null || symbol->kind != SymbolKind::Port || !symbol->bidirectional {
                this.Error("Port " + Quote(port->name) + " is 'inout'; connect it to an 'inout' port of this module.", value->span);
                return false;
            }

            if !SameType(symbol->_type, port->_type) {
                this.Error("Port " + Quote(port->name) + " expects " + Quote(port->_type->Describe()) + ", found " + Quote(symbol->_type->Describe()) + ".", value->span);
                return false;
            }

            (path->symbol, value->resolved) = (symbol, symbol->_type);
            return true;
        }

        let _type = this.CheckExpression(value, scope, Context::Module, port->_type);
        if _type->IsError() { return false; }

        if port->_type->IsClock() {
            if !_type->IsClock() {
                this.Error("Port " + Quote(port->name) + " expects a clock, found " + Quote(_type->Describe()) + ".", value->span);
                return false;
            }

            return true;
        }

        this.Coerce(value, port->_type)
    }

    fn MakePath(&mut this, name: &String, span: SourceSpan) -> *mut ASTPathExpression {
        let path = this.arena.New<ASTPathExpression>(span);
        path->segments.PushBack(name);
        path
    }

    fn EvalConstant(&mut this, expression: *mut ASTExpression, scope: *mut Scope) -> Option<i64> {
        match expression->kind {
            ASTExpressionKind::Integer => Option<i64>::Some((expression as *mut ASTIntegerLiteral)->literal),
            ASTExpressionKind::Boolean => Option<i64>::Some(if (expression as *mut ASTBooleanLiteral)->literal { 1 } else { 0 }),
            ASTExpressionKind::Path => {
                let path = expression as *mut ASTPathExpression;
                let symbol = scope->Lookup(path->segments[0]);

                if symbol == null {
                    this.Error("Cannot find " + Quote(path->segments[0]) + " in this scope.", expression->span);
                    return Option<i64>::None;
                }

                if path->segments.Length() == 1 && symbol->kind == SymbolKind::Constant {
                    if !this.ResolveSymbol(symbol) { return Option<i64>::None; }
                    return Option<i64>::Some(symbol->value);
                }

                if path->segments.Length() == 2 && symbol->kind == SymbolKind::Enumeration {
                    if !this.ResolveSymbol(symbol) { return Option<i64>::None; }
                    let index = symbol->enumeration->Find(path->segments[1]);

                    if index < 0 {
                        this.Error("Enum " + Quote(symbol->name) + " has no variant named " + Quote(path->segments[1]) + ".", expression->span);
                        return Option<i64>::None;
                    }

                    return Option<i64>::Some(symbol->enumeration->values[index as usize]);
                }

                this.Error(Quote(path->ToString()) + " is not a constant.", expression->span);
                Option<i64>::None
            },
            ASTExpressionKind::Unary => {
                let unary = expression as *mut ASTUnaryExpression;

                match this.EvalConstant(unary->operand, scope) {
                    Option<i64>::Some(value) => Option<i64>::Some(if unary->op == ASTUnaryKind::Negate { -value } else { !value }),
                    Option<i64>::None => Option<i64>::None
                }
            },
            ASTExpressionKind::Binary => {
                let binary = expression as *mut ASTBinaryExpression;
                let left = match this.EvalConstant(binary->left, scope) { Option<i64>::Some(value) => value, Option<i64>::None => { return Option<i64>::None; } };
                let right = match this.EvalConstant(binary->right, scope) { Option<i64>::Some(value) => value, Option<i64>::None => { return Option<i64>::None; } };
                this.FoldInteger(binary->op, left, right, expression->span)
            },
            ASTExpressionKind::Call => {
                let call = expression as *mut ASTCallExpression;

                if call->name != "clog2" || call->arguments.Length() != 1 {
                    this.Error("Only 'clog2(n)' can be called in a constant expression.", expression->span);
                    return Option<i64>::None;
                }

                match this.EvalConstant(call->arguments[0], scope) {
                    Option<i64>::Some(value) => Option<i64>::Some(Clog2(value)),
                    Option<i64>::None => Option<i64>::None
                }
            },
            ASTExpressionKind::Cast => {
                let cast = expression as *mut ASTCastExpression;
                let target = this.ResolveType(cast->target, scope);
                if target->IsError() { return Option<i64>::None; }

                match this.EvalConstant(cast->operand, scope) {
                    Option<i64>::Some(value) => Option<i64>::Some(Wrap(value, target)),
                    Option<i64>::None => Option<i64>::None
                }
            },
            ASTExpressionKind::If => {
                let conditional = expression as *mut ASTIfExpression;

                match this.EvalConstant(conditional->condition, scope) {
                    Option<i64>::Some(value) => this.EvalConstant(if value != 0 { conditional->then } else { conditional->otherwise }, scope),
                    Option<i64>::None => Option<i64>::None
                }
            },
            _ => {
                this.Error("Expected a constant expression.", expression->span);
                Option<i64>::None
            }
        }
    }

    fn FoldInteger(&mut this, op: ASTBinaryKind, left: i64, right: i64, span: SourceSpan) -> Option<i64> {
        if (op == ASTBinaryKind::Divide || op == ASTBinaryKind::Modulo) && right == 0 {
            this.Error("Division by zero in a constant expression.", span);
            return Option<i64>::None;
        }

        if op.IsShift() && (right < 0 || right > 63) {
            this.Error("Shift amount " + String::FromInteger(right) + " is out of range in a constant expression.", span);
            return Option<i64>::None;
        }

        Option<i64>::Some(match op {
            ASTBinaryKind::Add => left + right,
            ASTBinaryKind::Subtract => left - right,
            ASTBinaryKind::Multiply => left * right,
            ASTBinaryKind::Divide => left / right,
            ASTBinaryKind::Modulo => left % right,
            ASTBinaryKind::BitwiseAnd => left & right,
            ASTBinaryKind::BitwiseOr => left | right,
            ASTBinaryKind::BitwiseXor => left ^ right,
            ASTBinaryKind::LeftShift => left << right,
            ASTBinaryKind::RightShift => left >> right,
            ASTBinaryKind::Equal => if left == right { 1 } else { 0 },
            ASTBinaryKind::NotEqual => if left != right { 1 } else { 0 },
            ASTBinaryKind::Less => if left < right { 1 } else { 0 },
            ASTBinaryKind::Greater => if left > right { 1 } else { 0 },
            ASTBinaryKind::LessEqual => if left <= right { 1 } else { 0 },
            ASTBinaryKind::GreaterEqual => if left >= right { 1 } else { 0 },
            ASTBinaryKind::And => if left != 0 && right != 0 { 1 } else { 0 },
            ASTBinaryKind::Or => if left != 0 || right != 0 { 1 } else { 0 }
        })
    }

    fn SetConstant(&this, expression: *mut ASTExpression, _type: *mut Type, value: i64) -> *mut Type {
        (expression->resolved, expression->constant, expression->value) = (_type, true, Wrap(value, _type));
        _type
    }

    fn Fail(&this, expression: *mut ASTExpression) -> *mut Type {
        expression->resolved = this.error_type;
        this.error_type
    }

    fn Coerce(&mut this, expression: *mut ASTExpression, target: *mut Type) -> bool {
        let actual = expression->resolved;
        if actual == null || actual->IsError() || target->IsError() { return true; }

        if actual->IsInteger() {
            let bits = this.ValueType(target);

            if bits->IsBits() {
                if !Fits(expression->value, bits) {
                    this.Error("Constant " + String::FromInteger(expression->value) + " does not fit in " + Quote(bits->Describe()) + ".", expression->span);
                    return false;
                }

                expression->resolved = bits;
                return true;
            }

            if target->IsEnum() {
                this.Error("Expected " + Quote(target->Describe()) + ", found an integer; use a variant such as '" + target->enumeration->name + "::" + target->enumeration->names[0] + "'.", expression->span);
                return false;
            }

            this.Error("Expected " + Quote(target->Describe()) + ", found an integer.", expression->span);
            return false;
        }

        if SameType(actual, target) { return true; }
        if (target->IsReset() && actual->IsBool()) || (target->IsBool() && actual->IsReset()) { return true; }

        if target->IsBool() && actual->IsBits() {
            this.Error("Mismatched types: expected 'bool', found " + Quote(actual->Describe()) + "; compare it instead, for example 'x != 0'.", expression->span);
        } else if actual->IsBits() && target->IsBits() {
            this.Error("Mismatched types: expected " + Quote(target->Describe()) + ", found " + Quote(actual->Describe()) + "; convert with 'as " + target->Describe() + "'.", expression->span);
        } else {
            this.Error("Mismatched types: expected " + Quote(target->Describe()) + ", found " + Quote(actual->Describe()) + ".", expression->span);
        }

        false
    }

    fn ExpectBool(&mut this, expression: *mut ASTExpression, scope: *mut Scope, context: Context) -> bool {
        let _type = this.CheckExpression(expression, scope, context, this.bool_type);
        if _type->IsError() { return false; }
        if _type->IsBool() || _type->IsReset() { return true; }
        if _type->IsInteger() { return this.Coerce(expression, this.bool_type); }

        if _type->IsBits() {
            this.Error("Expected 'bool', found " + Quote(_type->Describe()) + "; compare it instead, for example 'x != 0'.", expression->span);
        } else {
            this.Error("Expected 'bool', found " + Quote(_type->Describe()) + ".", expression->span);
        }

        false
    }

    fn Unify(&mut this, left: *mut ASTExpression, right: *mut ASTExpression, scope: *mut Scope, context: Context, expected: *mut Type, span: SourceSpan) -> *mut Type {
        let mut hint = expected;
        if hint != null && !hint->IsBits() && !hint->IsEnum() { hint = null; }
        let left_type = this.ValueType(this.CheckExpression(left, scope, context, hint));
        let right_type = this.ValueType(this.CheckExpression(right, scope, context, if left_type->IsInteger() || left_type->IsError() { hint } else { left_type }));
        if left_type->IsError() || right_type->IsError() { return this.error_type; }

        if left_type->IsInteger() && right_type->IsInteger() { return this.integer_type; }

        if left_type->IsInteger() {
            return if this.Coerce(left, right_type) { right_type } else { this.error_type };
        }

        if right_type->IsInteger() {
            return if this.Coerce(right, left_type) { left_type } else { this.error_type };
        }

        if SameType(left_type, right_type) { return left_type; }

        if left_type->IsBits() && right_type->IsBits() {
            this.Error("Mismatched operand types " + Quote(left_type->Describe()) + " and " + Quote(right_type->Describe()) + "; convert one side with 'as'.", span);
        } else {
            this.Error("Mismatched operand types " + Quote(left_type->Describe()) + " and " + Quote(right_type->Describe()) + ".", span);
        }

        this.error_type
    }

    fn CheckExpression(&mut this, expression: *mut ASTExpression, scope: *mut Scope, context: Context, expected: *mut Type) -> *mut Type {
        let result = this.CheckExpressionInner(expression, scope, context, expected);
        if expression->resolved == null { expression->resolved = result; }
        expression->resolved
    }

    fn CheckExpressionInner(&mut this, expression: *mut ASTExpression, scope: *mut Scope, context: Context, expected: *mut Type) -> *mut Type {
        match expression->kind {
            ASTExpressionKind::Integer => this.SetConstant(expression, this.integer_type, (expression as *mut ASTIntegerLiteral)->literal),
            ASTExpressionKind::Boolean => this.SetConstant(expression, this.bool_type, if (expression as *mut ASTBooleanLiteral)->literal { 1 } else { 0 }),
            ASTExpressionKind::Path => this.CheckPath(expression as *mut ASTPathExpression, scope),
            ASTExpressionKind::Unary => this.CheckUnary(expression as *mut ASTUnaryExpression, scope, context, expected),
            ASTExpressionKind::Binary => this.CheckBinary(expression as *mut ASTBinaryExpression, scope, context, expected),
            ASTExpressionKind::Index => this.CheckIndex(expression as *mut ASTIndexExpression, scope, context),
            ASTExpressionKind::Slice => this.CheckSlice(expression as *mut ASTSliceExpression, scope, context),
            ASTExpressionKind::Member => this.CheckMember(expression as *mut ASTMemberExpression, scope),
            ASTExpressionKind::Call => this.CheckCall(expression as *mut ASTCallExpression, scope, context),
            ASTExpressionKind::Cast => this.CheckCast(expression as *mut ASTCastExpression, scope, context),
            ASTExpressionKind::If => this.CheckIf(expression as *mut ASTIfExpression, scope, context, expected),
            ASTExpressionKind::Instance => {
                this.Error("Module instances are only allowed as the value of a 'let' at module level.", expression->span);
                this.Fail(expression)
            },
            ASTExpressionKind::String => {
                this.Error("String literals are only allowed in 'readmemh'.", expression->span);
                this.Fail(expression)
            }
        }
    }

    fn CheckPath(&mut this, path: *mut ASTPathExpression, scope: *mut Scope) -> *mut Type {
        let name = path->segments[0];
        let symbol = scope->Lookup(name);

        if symbol == null {
            this.Error("Cannot find " + Quote(name) + " in this scope.", path->span);
            return this.Fail(path);
        }

        if path->segments.Length() > 2 {
            this.Error("Invalid path " + Quote(path->ToString()) + ".", path->span);
            return this.Fail(path);
        }

        if path->segments.Length() == 2 {
            if symbol->kind != SymbolKind::Enumeration {
                this.Error(Quote(name) + " is a " + symbol->kind.Describe() + ", not an enum.", path->span);
                return this.Fail(path);
            }

            if !this.ResolveSymbol(symbol) { return this.Fail(path); }
            let info = symbol->enumeration;
            let index = info->Find(path->segments[1]);

            if index < 0 {
                this.Error("Enum " + Quote(info->name) + " has no variant named " + Quote(path->segments[1]) + ".", path->span);
                return this.Fail(path);
            }

            path->symbol = symbol;
            return this.SetConstant(path, info->_type, info->values[index as usize]);
        }

        path->symbol = symbol;

        match symbol->kind {
            SymbolKind::Constant => {
                if !this.ResolveSymbol(symbol) { return this.Fail(path); }
                this.SetConstant(path, symbol->_type, symbol->value)
            },
            SymbolKind::Port | SymbolKind::Let | SymbolKind::Wire | SymbolKind::Register => {
                if symbol->bidirectional {
                    this.Error(Quote(name) + " is an 'inout' port; it can only be connected to an 'inout' port of an instance.", path->span);
                    return this.Fail(path);
                }

                if !this.ResolveSymbol(symbol) { return this.Fail(path); }
                symbol->_type
            },
            SymbolKind::Instance => {
                this.Error(Quote(name) + " is an instance; read one of its outputs with '" + name + ".<port>'.", path->span);
                this.Fail(path)
            },
            SymbolKind::Group => {
                if this.HoldsInstances(symbol) {
                    this.Error(Quote(name) + " is an array of instances; read an output with '" + name + "[k].<port>'.", path->span);
                    return this.Fail(path);
                }

                let _type = this.GroupType(symbol, null, path->span);
                if _type->IsError() { return this.Fail(path); }
                _type
            },
            _ => {
                this.Error(Quote(name) + " is a " + symbol->kind.Describe() + ", not a value.", path->span);
                this.Fail(path)
            }
        }
    }

    fn CheckUnary(&mut this, unary: *mut ASTUnaryExpression, scope: *mut Scope, context: Context, expected: *mut Type) -> *mut Type {
        let operand = this.ValueType(this.CheckExpression(unary->operand, scope, context, expected));
        if operand->IsError() { return this.Fail(unary); }

        if operand->IsInteger() {
            let value = unary->operand->value;
            return this.SetConstant(unary, this.integer_type, if unary->op == ASTUnaryKind::Negate { -value } else { !value });
        }

        if !operand->IsBits() {
            this.Error("Cannot apply '".ToString() + (if unary->op == ASTUnaryKind::Negate { "-" } else { "!" }) + "' to " + Quote(operand->Describe()) + ".", unary->span);
            return this.Fail(unary);
        }

        if unary->op == ASTUnaryKind::Negate && operand->IsBool() {
            this.Error("Cannot negate a 'bool'; use '!' for logical not.", unary->span);
            return this.Fail(unary);
        }

        if unary->operand->constant {
            let value = unary->operand->value;
            return this.SetConstant(unary, operand, if unary->op == ASTUnaryKind::Negate { -value } else { !value });
        }

        operand
    }

    fn CheckBinary(&mut this, binary: *mut ASTBinaryExpression, scope: *mut Scope, context: Context, expected: *mut Type) -> *mut Type {
        let op = binary->op;

        if op.IsLogical() {
            let decisive: i64 = if op == ASTBinaryKind::And { 0 } else { 1 };
            let left = this.ExpectBool(binary->left, scope, context);
            if !left { return this.Fail(binary); }

            if binary->left->constant {
                if (binary->left->value != 0) == (decisive != 0) { return this.SetConstant(binary, this.bool_type, decisive); }
                if !this.ExpectBool(binary->right, scope, context) { return this.Fail(binary); }
                if binary->right->constant { return this.SetConstant(binary, this.bool_type, if binary->right->value != 0 { 1 } else { 0 }); }
                binary->folded = binary->right;
                return this.bool_type;
            }

            if !this.ExpectBool(binary->right, scope, context) { return this.Fail(binary); }

            if binary->right->constant {
                if (binary->right->value != 0) == (decisive != 0) { return this.SetConstant(binary, this.bool_type, decisive); }
                binary->folded = binary->left;
            }

            return this.bool_type;
        }

        if op.IsShift() {
            let left = this.ValueType(this.CheckExpression(binary->left, scope, context, expected));
            let right = this.ValueType(this.CheckExpression(binary->right, scope, context, null));
            if left->IsError() || right->IsError() { return this.Fail(binary); }

            if right->IsInteger() {
                if binary->right->value < 0 {
                    this.Error("Shift amount cannot be negative.", binary->right->span);
                    return this.Fail(binary);
                }
            } else if !right->IsBits() || right->signed {
                this.Error("Shift amount must be unsigned, found " + Quote(right->Describe()) + ".", binary->right->span);
                return this.Fail(binary);
            }

            let mut result = left;

            if left->IsInteger() {
                if right->IsInteger() {
                    return match this.FoldInteger(op, binary->left->value, binary->right->value, binary->span) {
                        Option<i64>::Some(value) => this.SetConstant(binary, this.integer_type, value),
                        Option<i64>::None => this.Fail(binary)
                    };
                }

                if expected == null || !this.ValueType(expected)->IsBits() {
                    this.Error("Cannot infer the width of the shifted constant; write it as '(" + String::FromInteger(binary->left->value) + " as u8)' with the width you need.", binary->left->span);
                    return this.Fail(binary);
                }

                result = this.ValueType(expected);
                if !this.Coerce(binary->left, result) { return this.Fail(binary); }
            } else if !left->IsBits() {
                this.Error("Cannot shift a value of type " + Quote(left->Describe()) + ".", binary->left->span);
                return this.Fail(binary);
            }

            if binary->left->constant && binary->right->constant && binary->right->value < 64 {
                let value = if op == ASTBinaryKind::LeftShift { binary->left->value << binary->right->value } else { binary->left->value >> binary->right->value };
                return this.SetConstant(binary, result, value);
            }

            return result;
        }

        let operands = this.Unify(binary->left, binary->right, scope, context, if op.IsComparison() { null } else { expected }, binary->span);
        if operands->IsError() { return this.Fail(binary); }

        if operands->IsEnum() && op != ASTBinaryKind::Equal && op != ASTBinaryKind::NotEqual {
            this.Error("Enums can only be compared with '==' and '!='.", binary->span);
            return this.Fail(binary);
        }

        if !operands->IsInteger() && !operands->IsBits() && !operands->IsEnum() {
            this.Error("Operator '" + op.Text() + "' cannot be used with " + Quote(operands->Describe()) + ".", binary->span);
            return this.Fail(binary);
        }

        let arithmetic = op == ASTBinaryKind::Add || op == ASTBinaryKind::Subtract || op == ASTBinaryKind::Multiply || op == ASTBinaryKind::Divide || op == ASTBinaryKind::Modulo;

        if arithmetic && operands->IsBool() {
            this.Error("Arithmetic on 'bool' is not allowed; use '&', '|' or '^' instead.", binary->span);
            return this.Fail(binary);
        }

        let result = if op.IsComparison() { this.bool_type } else { operands };

        if binary->left->constant && binary->right->constant {
            return match this.FoldInteger(op, binary->left->value, binary->right->value, binary->span) {
                Option<i64>::Some(value) => this.SetConstant(binary, result, value),
                Option<i64>::None => this.Fail(binary)
            };
        }

        result
    }

    fn CheckIndexValue(&mut this, index: *mut ASTExpression, scope: *mut Scope, context: Context, limit: i64) -> bool {
        let _type = this.ValueType(this.CheckExpression(index, scope, context, null));
        if _type->IsError() { return false; }

        if _type->IsInteger() {
            if index->value < 0 || index->value >= limit {
                this.Error("Index " + String::FromInteger(index->value) + " is out of range for a size of " + String::FromInteger(limit) + ".", index->span);
                return false;
            }

            return true;
        }

        if !_type->IsBits() || _type->signed {
            this.Error("Index must be unsigned, found " + Quote(_type->Describe()) + ".", index->span);
            return false;
        }

        true
    }

    fn CheckIndex(&mut this, index: *mut ASTIndexExpression, scope: *mut Scope, context: Context) -> *mut Type {
        index->element = null;
        index->choices.Clear();
        let base = this.CheckExpression(index->base, scope, context, null);
        if base->IsError() { return this.Fail(index); }
        if base->IsGroup() { return this.CheckGroupIndex(index, base, scope, context); }

        if base->IsArray() {
            if !this.CheckIndexValue(index->index, scope, context, base->length as i64) { return this.Fail(index); }
            return base->element;
        }

        if !base->IsBits() {
            this.Error("Cannot index a value of type " + Quote(base->Describe()) + ".", index->base->span);
            return this.Fail(index);
        }

        if !this.CheckIndexValue(index->index, scope, context, base->width as i64) { return this.Fail(index); }
        this.bool_type
    }

    fn CheckGroupIndex(&mut this, index: *mut ASTIndexExpression, group: *mut Type, scope: *mut Scope, context: Context) -> *mut Type {
        let _type = this.ValueType(this.CheckExpression(index->index, scope, context, null));
        if _type->IsError() { return this.Fail(index); }
        let start = group->group->value;

        if index->index->constant {
            let position = index->index->value - start;

            if position < 0 || position >= group->length as i64 {
                this.Error("Index " + String::FromInteger(index->index->value) + " is out of range for " + Quote(group->group->name) + ", which has elements " +
                    String::FromInteger(start) + " to " + String::FromInteger(start + group->length as i64 - 1) + ".", index->index->span);
                return this.Fail(index);
            }

            index->element = this.GroupElement(index->base, group, position);
            return index->element->resolved;
        }

        if !_type->IsBits() || _type->signed {
            this.Error("Index must be unsigned, found " + Quote(_type->Describe()) + ".", index->index->span);
            return this.Fail(index);
        }

        if group->element->IsGroup() {
            this.Error("Only the last index of a nested array can be a signal.", index->index->span);
            return this.Fail(index);
        }

        for position in 0..(group->length as i64) {
            if _type->width < 32 && start + position >= ((1 as i64) << (_type->width as i64)) { break; }
            index->choices.PushBack(this.GroupElement(index->base, group, position));
        }

        if index->choices.Empty() {
            this.Error("Index of type " + Quote(_type->Describe()) + " cannot select any element of " + Quote(group->group->name) + ".", index->index->span);
            return this.Fail(index);
        }

        group->element
    }

    fn CheckSlice(&mut this, slice: *mut ASTSliceExpression, scope: *mut Scope, context: Context) -> *mut Type {
        let base = this.CheckExpression(slice->base, scope, context, null);
        if base->IsError() { return this.Fail(slice); }

        if !base->IsBits() {
            this.Error("Cannot slice a value of type " + Quote(base->Describe()) + ".", slice->base->span);
            return this.Fail(slice);
        }

        let high = match this.EvalConstant(slice->high, scope) { Option<i64>::Some(value) => value, Option<i64>::None => { return this.Fail(slice); } };
        let low = match this.EvalConstant(slice->low, scope) { Option<i64>::Some(value) => value, Option<i64>::None => { return this.Fail(slice); } };

        if low < 0 || high < low || high >= base->width as i64 {
            this.Error("Slice [" + String::FromInteger(high) + ":" + String::FromInteger(low) + "] is out of range for " + Quote(base->Describe()) + ".", slice->span);
            return this.Fail(slice);
        }

        (slice->high_value, slice->low_value) = (high, low);
        this.MakeBits((high - low + 1) as u32, false)
    }

    fn CheckMember(&mut this, member: *mut ASTMemberExpression, scope: *mut Scope) -> *mut Type {
        let base = member->base;

        if base->kind == ASTExpressionKind::Path && (base as *mut ASTPathExpression)->segments.Length() == 1 {
            let group = scope->Lookup((base as *mut ASTPathExpression)->segments[0]);

            if group != null && group->kind == SymbolKind::Group && !group->elements.Empty() && group->elements[0]->kind == SymbolKind::Instance {
                return this.CheckGroupMember(member, group);
            }
        }

        let symbol = this.InstanceOf(base, scope);
        if symbol == null { return this.Fail(member); }
        let module = this.InstanceModule(symbol);
        if module == null { return this.Fail(member); }
        let port = module->FindPort(member->name);

        if port == null {
            let group = module->FindPortGroup(member->name);

            if group != null && !group->elements[0]->input {
                (member->instance, member->port) = (symbol, group);
                let _type = this.GroupType(group, symbol, member->span);
                if _type->IsError() { return this.Fail(member); }
                return _type;
            }

            if group != null {
                this.Error(Quote(member->name) + " is an input of " + Quote(module->name) + "; only outputs can be read.", member->span);
                return this.Fail(member);
            }

            if module->disabled.Contains(member->name) {
                this.Error("Port " + Quote(member->name) + " of " + Quote(module->name) + " is switched off by its '#[if]' condition.", member->span);
                return this.Fail(member);
            }

            this.Error("Module " + Quote(module->name) + " has no port named " + Quote(member->name) + ".", member->span);
            return this.Fail(member);
        }

        if port->input {
            this.Error(Quote(member->name) + " is " + (if port->bidirectional { "an 'inout' port" } else { "an input" }) + " of " + Quote(module->name) + "; only outputs can be read.", member->span);
            return this.Fail(member);
        }

        (member->instance, member->port) = (symbol, port);
        base->resolved = this.error_type;
        port->_type
    }

    fn CheckGroupMember(&mut this, member: *mut ASTMemberExpression, group: *mut Symbol) -> *mut Type {
        let mut port: *mut Symbol = null;

        for element in group->elements {
            let module = this.InstanceModule(element);
            if module == null { return this.Fail(member); }
            let found = module->FindPort(member->name);

            if found == null || found->input {
                this.Error("Module " + Quote(module->name) + " has no output named " + Quote(member->name) + ".", member->span);
                return this.Fail(member);
            }

            if port != null && port != found {
                this.Error("The elements of " + Quote(group->name) + " are instances of different modules.", member->span);
                return this.Fail(member);
            }

            port = found;
        }

        let result = this.arena.New<Type>(TypeKind::Group);
        (result->element, result->length, result->group, result->port) = (port->_type, group->elements.Length() as u32, group, port);
        member->base->resolved = this.error_type;
        result
    }

    fn CheckCall(&mut this, call: *mut ASTCallExpression, scope: *mut Scope, context: Context) -> *mut Type {
        let name = call->name;
        let count = call->arguments.Length();

        if name == "clog2" {
            return match this.EvalConstant(call, scope) {
                Option<i64>::Some(value) => this.SetConstant(call, this.integer_type, value),
                Option<i64>::None => this.Fail(call)
            };
        }

        if name == "cat" {
            if count == 0 {
                this.Error("'cat' needs at least one argument.", call->span);
                return this.Fail(call);
            }

            let mut width: i64 = 0;
            let mut valid = true;

            for argument in call->arguments {
                let _type = this.ValueType(this.CheckExpression(argument, scope, context, null));

                if _type->IsError() {
                    valid = false;
                } else if _type->IsInteger() {
                    this.Error("Constants in 'cat' need an explicit width, for example '" + String::FromInteger(argument->value) + " as u4'.", argument->span);
                    valid = false;
                } else if !_type->IsBits() {
                    this.Error("Cannot concatenate a value of type " + Quote(_type->Describe()) + ".", argument->span);
                    valid = false;
                } else {
                    width += _type->width as i64;
                }
            }

            if !valid { return this.Fail(call); }

            if width > MAX_WIDTH {
                this.Error("Concatenation is wider than " + String::FromInteger(MAX_WIDTH) + " bits.", call->span);
                return this.Fail(call);
            }

            return this.MakeBits(width as u32, false);
        }

        if name == "rep" {
            if count != 2 {
                this.Error("'rep' takes a count and a value, for example 'rep(4, bit)'.", call->span);
                return this.Fail(call);
            }

            let times = match this.EvalConstant(call->arguments[0], scope) { Option<i64>::Some(value) => value, Option<i64>::None => { return this.Fail(call); } };
            this.SetConstant(call->arguments[0], this.integer_type, times);
            let _type = this.ValueType(this.CheckExpression(call->arguments[1], scope, context, null));
            if _type->IsError() { return this.Fail(call); }

            if !_type->IsBits() {
                this.Error("'rep' needs a bit vector with a known width, found " + Quote(_type->Describe()) + ".", call->arguments[1]->span);
                return this.Fail(call);
            }

            if times < 1 || times * (_type->width as i64) > MAX_WIDTH {
                this.Error("Invalid repetition count " + String::FromInteger(times) + ".", call->arguments[0]->span);
                return this.Fail(call);
            }

            return this.MakeBits((times * (_type->width as i64)) as u32, false);
        }

        if name == "any" || name == "all" || name == "parity" {
            if count != 1 {
                this.Error(Quote(name) + " takes exactly one argument.", call->span);
                return this.Fail(call);
            }

            let _type = this.ValueType(this.CheckExpression(call->arguments[0], scope, context, null));
            if _type->IsError() { return this.Fail(call); }

            if !_type->IsBits() {
                this.Error(Quote(name) + " needs a bit vector, found " + Quote(_type->Describe()) + ".", call->arguments[0]->span);
                return this.Fail(call);
            }

            return this.bool_type;
        }

        this.Error("Unknown function " + Quote(name) + ".", call->span);
        this.Fail(call)
    }

    fn CheckCast(&mut this, cast: *mut ASTCastExpression, scope: *mut Scope, context: Context) -> *mut Type {
        let target = this.ResolveType(cast->target, scope);
        let source = this.ValueType(this.CheckExpression(cast->operand, scope, context, null));
        if target->IsError() || source->IsError() { return this.Fail(cast); }

        if target->IsEnum() {
            let info = target->enumeration;

            if source->IsInteger() {
                if info->FindValue(cast->operand->value) < 0 {
                    this.Error(String::FromInteger(cast->operand->value) + " is not a value of " + Quote(info->name) + ".", cast->operand->span);
                    return this.Fail(cast);
                }

                return this.SetConstant(cast, target, cast->operand->value);
            }

            if !source->IsBits() || source->signed || source->width != info->width {
                this.Error("Only a 'u" + String::FromInteger(info->width as u64) + "' can be cast to " + Quote(info->name) + ", found " + Quote(source->Describe()) + ".", cast->operand->span);
                return this.Fail(cast);
            }

            return target;
        }

        if !target->IsBits() {
            this.Error("Cannot cast to " + Quote(target->Describe()) + ".", cast->target->span);
            return this.Fail(cast);
        }

        if !source->IsInteger() && !source->IsBits() && !source->IsEnum() {
            this.Error("Cannot cast a value of type " + Quote(source->Describe()) + ".", cast->operand->span);
            return this.Fail(cast);
        }

        if cast->operand->constant {
            return this.SetConstant(cast, target, cast->operand->value);
        }

        target
    }

    fn CheckIf(&mut this, conditional: *mut ASTIfExpression, scope: *mut Scope, context: Context, expected: *mut Type) -> *mut Type {
        let condition = this.ExpectBool(conditional->condition, scope, context);

        if condition && conditional->condition->constant {
            let chosen = if conditional->condition->value != 0 { conditional->then } else { conditional->otherwise };
            conditional->chosen = chosen;
            let result = this.CheckExpression(chosen, scope, context, expected);
            if result->IsError() { return this.Fail(conditional); }
            if chosen->constant { return this.SetConstant(conditional, result, chosen->value); }
            return result;
        }
        let result = this.Unify(conditional->then, conditional->otherwise, scope, context, expected, conditional->span);
        if !condition || result->IsError() { return this.Fail(conditional); }

        if result->IsInteger() && !conditional->condition->constant {
            if expected == null || !this.ValueType(expected)->IsBits() {
                this.Error("Cannot infer the width of this 'if' expression; give one branch an explicit type with 'as'.", conditional->span);
                return this.Fail(conditional);
            }

            let bits = this.ValueType(expected);
            if !this.Coerce(conditional->then, bits) || !this.Coerce(conditional->otherwise, bits) { return this.Fail(conditional); }
            return bits;
        }

        if conditional->condition->constant {
            let chosen = if conditional->condition->value != 0 { conditional->then } else { conditional->otherwise };
            if chosen->constant { return this.SetConstant(conditional, result, chosen->value); }
        }

        result
    }

    pub fn Check(&mut this, files: &Vector<*mut ASTFile>) {
        if !files.Empty() { this.root = files[0]; }

        for file in files {
            for item in file->items {
                this.Declare(item, this.global, null);
            }
        }

        for file in files {
            for item in file->items {
                match item->kind {
                    ASTItemKind::Const => { this.ResolveSymbol((item as *mut ASTConstItem)->symbol); },
                    ASTItemKind::Type => { this.ResolveSymbol((item as *mut ASTTypeItem)->symbol); },
                    ASTItemKind::Enum => { this.ResolveSymbol((item as *mut ASTEnumItem)->symbol); },
                    ASTItemKind::Module => { this.ResolveSymbol((item as *mut ASTModuleItem)->info->symbol); },
                    _ => {}
                }
            }
        }

        for module in this.modules {
            if !module->item->external && module->ports_resolved {
                this.CheckModule(module);
            }
        }
    }

    fn CheckModule(&mut this, module: *mut ModuleInfo) {
        this.current = module;
        let scope = module->scope;
        let item = module->item;
        this.DeclareItems(item->items, scope, module, String(), module->elaborated, module->scopes);

        for port in module->ports {
            if port->init == null { continue; }

            if !port->registered {
                this.Error("Only 'out reg' ports can have an initial value.", port->init->span);
                continue;
            }

            if !port->_type->IsError() {
                this.CheckInitial(port->init, scope, port->_type);
            }
        }

        for child in module->elaborated {
            match child->kind {
                ASTItemKind::Const => { this.ResolveSymbol((child as *mut ASTConstItem)->symbol); },
                ASTItemKind::Type => { this.ResolveSymbol((child as *mut ASTTypeItem)->symbol); },
                ASTItemKind::Enum => { this.ResolveSymbol((child as *mut ASTEnumItem)->symbol); },
                ASTItemKind::Signal => { this.ResolveSymbol((child as *mut ASTSignalItem)->symbol); },
                _ => {}
            }
        }

        for i in 0..module->elaborated.Length() {
            let child = module->elaborated[i];
            let child_scope = module->scopes[i];

            match child->kind {
                ASTItemKind::Assign => this.CheckAssignItem(child as *mut ASTAssignItem, child_scope),
                ASTItemKind::Comb => this.CheckComb(child as *mut ASTCombItem, child_scope),
                ASTItemKind::Seq => this.CheckSeq(child as *mut ASTSeqItem, child_scope),
                _ => {}
            }
        }

        this.CheckNames(module);

        let mut symbols = module->ports;
        symbols += module->signals;

        for symbol in symbols {
            if symbol->driver != DriverKind::None || symbol->_type == null || symbol->_type->IsError() { continue; }

            if symbol->kind == SymbolKind::Port && symbol->output {
                if symbol->registered {
                    this.Error("Output " + Quote(symbol->name) + " is never assigned; assign it in a 'seq' block.", symbol->span);
                } else {
                    this.Error("Output " + Quote(symbol->name) + " is never driven.", symbol->span);
                }
            } else if symbol->kind == SymbolKind::Wire {
                this.Error("Wire " + Quote(symbol->name) + " is never driven.", symbol->span);
            } else if symbol->kind == SymbolKind::Register && symbol->memory_file.Empty() {
                this.Error("Register " + Quote(symbol->name) + " is never assigned; assign it in a 'seq' block or make it a 'const'.", symbol->span);
            }
        }

        this.current = null;
    }

    fn CheckNames(&mut this, module: *mut ModuleInfo) {
        let mut symbols = module->ports;
        symbols += module->signals;

        for i in 0..symbols.Length() {
            for j in 0..i {
                if symbols[i]->name == symbols[j]->name {
                    this.Error(Quote(symbols[i]->name) + " is emitted twice; an array element is emitted as '<name>_<index>', so rename one of them.", symbols[i]->span);
                    this.Note("The other one is here.", symbols[j]->span);
                    break;
                }
            }
        }
    }

    fn RecordDriver(&mut this, symbol: *mut Symbol, kind: DriverKind, node: *mut ASTNode, span: SourceSpan) {
        if symbol->driver == DriverKind::None {
            (symbol->driver, symbol->driver_node, symbol->driver_span) = (kind, node, span);
            return;
        }

        if symbol->driver == kind && symbol->driver_node == node { return; }
        this.Error(Quote(symbol->name) + " is already driven elsewhere; a signal can only have one driver.", span);
        this.Note("It is first driven here.", symbol->driver_span);
    }

    fn CheckAssignItem(&mut this, item: *mut ASTAssignItem, scope: *mut Scope) {
        let target = item->target;

        if target->kind == ASTExpressionKind::Index && this.TargetGroup((target as *mut ASTIndexExpression)->base, scope) != null {
            let symbol = this.CheckTarget(target, scope, Context::Module);
            if symbol == null { return; }
            item->symbol = symbol;
            this.RecordDriver(symbol, DriverKind::Assign, item, item->span);
            this.CheckExpression(item->value, scope, Context::Module, symbol->_type);
            this.Coerce(item->value, symbol->_type);
            return;
        }

        if target->kind != ASTExpressionKind::Path || (target as *mut ASTPathExpression)->segments.Length() != 1 {
            this.Error("Continuous assignments must assign a whole wire or output; partial assignments are only allowed in 'seq' blocks.", target->span);
            return;
        }

        let symbol = this.CheckTargetSymbol(target as *mut ASTPathExpression, scope, Context::Module);
        if symbol == null { return; }
        item->symbol = symbol;
        this.RecordDriver(symbol, DriverKind::Assign, item, item->span);
        this.CheckExpression(item->value, scope, Context::Module, symbol->_type);
        this.Coerce(item->value, symbol->_type);
    }

    fn CheckTargetSymbol(&mut this, path: *mut ASTPathExpression, scope: *mut Scope, context: Context) -> *mut Symbol {
        let name = path->segments[0];
        let symbol = scope->Lookup(name);

        if symbol == null || path->segments.Length() != 1 {
            this.Error("Cannot find " + Quote(path->ToString()) + " in this scope.", path->span);
            return null;
        }

        if symbol->kind == SymbolKind::Group {
            this.Error(Quote(name) + " is an array; assign one element at a time with '" + name + "[k]'.", path->span);
            return null;
        }

        this.CheckTargetKind(symbol, path, context)
    }

    fn TargetGroup(&mut this, expression: *mut ASTExpression, scope: *mut Scope) -> *mut Symbol {
        if expression->kind != ASTExpressionKind::Path || (expression as *mut ASTPathExpression)->segments.Length() != 1 { return null; }
        let symbol = scope->Lookup((expression as *mut ASTPathExpression)->segments[0]);
        if symbol == null || symbol->kind != SymbolKind::Group { return null; }
        symbol
    }

    fn CheckElementTarget(&mut this, index: *mut ASTIndexExpression, group: *mut Symbol, scope: *mut Scope, context: Context) -> *mut Symbol {
        let _type = this.CheckExpression(index->index, scope, context, null);
        if _type->IsError() { return null; }

        if !index->index->constant {
            this.Error("An element of " + Quote(group->name) + " can only be assigned with a constant index.", index->index->span);
            return null;
        }

        let element = this.SelectElement(group, index->index, scope);
        if element == null { return null; }

        if element->kind == SymbolKind::Group || element->kind == SymbolKind::Instance {
            this.Error("Cannot assign to an element of " + Quote(group->name) + ", which is a " + element->kind.Describe() + ".", index->span);
            return null;
        }

        let path = this.MakePath(element->name, index->span);
        let symbol = this.CheckTargetKind(element, path, context);
        if symbol == null { return null; }
        index->element = path;
        index->resolved = symbol->_type;
        symbol
    }

    fn CheckTargetKind(&mut this, symbol: *mut Symbol, path: *mut ASTPathExpression, context: Context) -> *mut Symbol {
        let name = symbol->name;

        if !symbol->IsSignal() {
            this.Error("Cannot assign to " + Quote(name) + ", which is a " + symbol->kind.Describe() + ".", path->span);
            return null;
        }

        if !this.ResolveSymbol(symbol) { return null; }
        path->symbol = symbol;
        path->resolved = symbol->_type;

        if symbol->kind == SymbolKind::Port && symbol->input {
            this.Error("Cannot assign to input " + Quote(name) + ".", path->span);
            return null;
        }

        if symbol->kind == SymbolKind::Let {
            this.Error(Quote(name) + " is declared with 'let' and already has a value; declare it with 'wire' to drive it separately.", path->span);
            return null;
        }

        if context == Context::Seq {
            if !symbol->registered {
                this.Error(Quote(name) + " is not a register; only 'reg' signals and 'out reg' ports can be assigned in 'seq' blocks.", path->span);
                return null;
            }
        } else if symbol->registered {
            this.Error(Quote(name) + " is a register; assign it in a 'seq' block with '<-'.", path->span);
            return null;
        }

        symbol
    }

    fn CheckTarget(&mut this, target: *mut ASTExpression, scope: *mut Scope, context: Context) -> *mut Symbol {
        if target->kind == ASTExpressionKind::Index {
            let index = target as *mut ASTIndexExpression;
            let group = this.TargetGroup(index->base, scope);
            if group != null { return this.CheckElementTarget(index, group, scope, context); }
        }

        match target->kind {
            ASTExpressionKind::Path => this.CheckTargetSymbol(target as *mut ASTPathExpression, scope, context),
            ASTExpressionKind::Index | ASTExpressionKind::Slice => {
                let base = if target->kind == ASTExpressionKind::Index { (target as *mut ASTIndexExpression)->base } else { (target as *mut ASTSliceExpression)->base };
                let symbol = this.CheckTarget(base, scope, context);
                if symbol == null { return null; }
                if this.CheckExpression(target, scope, context, null)->IsError() { return null; }
                symbol
            },
            _ => {
                this.Error("Invalid assignment target.", target->span);
                null
            }
        }
    }

    fn CheckComb(&mut this, item: *mut ASTCombItem, scope: *mut Scope) {
        this.block = item;
        this.CheckStatement(item->body, scope, Context::Comb);
        let mut assigned = Vector<*mut Symbol>();
        this.CollectAssigned(item->body, assigned);
        let definite = this.Definite(item->body);

        for symbol in assigned {
            if !definite.Contains(symbol) {
                this.Error(Quote(symbol->name) + " is not assigned on every path through this 'comb' block, which would infer a latch; give it a default value at the start of the block.", item->span);
            }
        }

        this.block = null;
    }

    fn CheckSeq(&mut this, item: *mut ASTSeqItem, scope: *mut Scope) {
        this.block = item;

        if item->clock == null {
            if this.current->clock == null {
                this.Error("Module " + Quote(this.current->name) + " has no clock input; add a 'clock' port or name one with 'seq(clk)'.", item->span);
            } else {
                item->clock = this.MakePath(this.current->clock->name, item->span);
                if this.current->reset != null { item->reset = this.MakePath(this.current->reset->name, item->span); }
            }
        }

        if item->clock != null {
            let clock = this.CheckExpression(item->clock, scope, Context::Module, null);

            if !clock->IsError() && !clock->IsClock() {
                this.Error("Expected a clock, found " + Quote(clock->Describe()) + ".", item->clock->span);
            }
        }

        if item->reset != null {
            let reset = this.CheckExpression(item->reset, scope, Context::Module, null);

            if !reset->IsError() && !reset->IsReset() && !reset->IsBool() {
                this.Error("Expected a reset, found " + Quote(reset->Describe()) + ".", item->reset->span);
            }
        }

        this.CheckStatement(item->body, scope, Context::Seq);
        let mut symbols = this.current->ports;
        symbols += this.current->signals;

        for symbol in symbols {
            if symbol->driver_node != item as *mut ASTNode || symbol->init == null { continue; }

            if item->reset != null {
                item->registers.PushBack(symbol);
            } else {
                symbol->power_on = true;
            }
        }

        this.block = null;
    }

    fn CheckStatement(&mut this, statement: *mut ASTStatement, scope: *mut Scope, context: Context) {
        match statement->kind {
            ASTStatementKind::Block => {
                for child in (statement as *mut ASTBlockStatement)->statements {
                    this.CheckStatement(child, scope, context);
                }
            },
            ASTStatementKind::Assign => this.CheckAssign(statement as *mut ASTAssignStatement, scope, context),
            ASTStatementKind::If => {
                let conditional = statement as *mut ASTIfStatement;
                let valid = this.ExpectBool(conditional->condition, scope, context);

                if valid && conditional->condition->constant {
                    conditional->folded = true;
                    conditional->chosen = if conditional->condition->value != 0 { conditional->then as *mut ASTStatement } else { conditional->otherwise };
                    if conditional->chosen != null { this.CheckStatement(conditional->chosen, scope, context); }
                    return;
                }

                this.CheckStatement(conditional->then, scope, context);
                if conditional->otherwise != null { this.CheckStatement(conditional->otherwise, scope, context); }
            },
            ASTStatementKind::Match => this.CheckMatch(statement as *mut ASTMatchStatement, scope, context),
            ASTStatementKind::For => this.CheckFor(statement as *mut ASTForStatement, scope, context)
        }
    }

    fn CheckFor(&mut this, statement: *mut ASTForStatement, scope: *mut Scope, context: Context) {
        let first = match this.EvalConstant(statement->start, scope) { Option<i64>::Some(value) => value, Option<i64>::None => { return; } };
        let last = match this.EvalConstant(statement->end, scope) { Option<i64>::Some(value) => value, Option<i64>::None => { return; } };

        if last - first > 65536 {
            this.Error("A 'for' loop can have at most 65536 iterations.", statement->span);
            return;
        }

        statement->unrolled = this.arena.New<ASTBlockStatement>(statement->span);
        let mut value = first;

        while value < last {
            let inner = this.arena.New<Scope>(scope);
            let symbol = this.NewSymbol(SymbolKind::Constant, statement->variable, statement->span, statement);
            (symbol->value, symbol->_type, symbol->resolved) = (value, this.integer_type, true);
            this.Define(inner, symbol);
            let body = this.CloneStatement(statement->body);
            this.CheckStatement(body, inner, context);
            statement->unrolled->statements.PushBack(body);
            value += 1;
        }
    }

    fn CloneExpression(&mut this, expression: *mut ASTExpression) -> *mut ASTExpression {
        if expression == null { return null; }
        let span = expression->span;

        match expression->kind {
            ASTExpressionKind::Integer => {
                let literal = expression as *mut ASTIntegerLiteral;
                this.arena.New<ASTIntegerLiteral>(literal->literal, literal->radix, span)
            },
            ASTExpressionKind::Boolean => this.arena.New<ASTBooleanLiteral>((expression as *mut ASTBooleanLiteral)->literal, span),
            ASTExpressionKind::String => this.arena.New<ASTStringLiteral>((expression as *mut ASTStringLiteral)->text, span),
            ASTExpressionKind::Path => {
                let path = this.arena.New<ASTPathExpression>(span);
                path->segments = (expression as *mut ASTPathExpression)->segments;
                path
            },
            ASTExpressionKind::Unary => {
                let unary = expression as *mut ASTUnaryExpression;
                this.arena.New<ASTUnaryExpression>(unary->op, this.CloneExpression(unary->operand), span)
            },
            ASTExpressionKind::Binary => {
                let binary = expression as *mut ASTBinaryExpression;
                this.arena.New<ASTBinaryExpression>(binary->op, this.CloneExpression(binary->left), this.CloneExpression(binary->right), span)
            },
            ASTExpressionKind::Index => {
                let index = expression as *mut ASTIndexExpression;
                this.arena.New<ASTIndexExpression>(this.CloneExpression(index->base), this.CloneExpression(index->index), span)
            },
            ASTExpressionKind::Slice => {
                let slice = expression as *mut ASTSliceExpression;
                this.arena.New<ASTSliceExpression>(this.CloneExpression(slice->base), this.CloneExpression(slice->high), this.CloneExpression(slice->low), span)
            },
            ASTExpressionKind::Member => {
                let member = expression as *mut ASTMemberExpression;
                this.arena.New<ASTMemberExpression>(this.CloneExpression(member->base), member->name, span)
            },
            ASTExpressionKind::Call => {
                let call = expression as *mut ASTCallExpression;
                let result = this.arena.New<ASTCallExpression>(call->name, span);

                for argument in call->arguments {
                    result->arguments.PushBack(this.CloneExpression(argument));
                }

                result
            },
            ASTExpressionKind::Cast => {
                let cast = expression as *mut ASTCastExpression;
                this.arena.New<ASTCastExpression>(this.CloneExpression(cast->operand), cast->target, span)
            },
            ASTExpressionKind::If => {
                let conditional = expression as *mut ASTIfExpression;
                this.arena.New<ASTIfExpression>(this.CloneExpression(conditional->condition), this.CloneExpression(conditional->then), this.CloneExpression(conditional->otherwise), span)
            },
            ASTExpressionKind::Instance => {
                let instance = expression as *mut ASTInstanceExpression;
                let result = this.arena.New<ASTInstanceExpression>(instance->module, span);

                for parameter in instance->parameters {
                    result->parameters.PushBack(this.arena.New<ASTConnection>(parameter->name, this.CloneExpression(parameter->value), parameter->span));
                }

                for connection in instance->connections {
                    result->connections.PushBack(this.arena.New<ASTConnection>(connection->name, this.CloneExpression(connection->value), connection->span));
                }

                result
            }
        }
    }

    fn CloneStatement(&mut this, statement: *mut ASTStatement) -> *mut ASTStatement {
        if statement == null { return null; }
        let span = statement->span;

        match statement->kind {
            ASTStatementKind::Block => this.CloneBlock(statement as *mut ASTBlockStatement),
            ASTStatementKind::Assign => {
                let assign = statement as *mut ASTAssignStatement;
                this.arena.New<ASTAssignStatement>(this.CloneExpression(assign->target), this.CloneExpression(assign->value), assign->nonblocking, span)
            },
            ASTStatementKind::If => {
                let conditional = statement as *mut ASTIfStatement;
                this.arena.New<ASTIfStatement>(this.CloneExpression(conditional->condition), this.CloneBlock(conditional->then), this.CloneStatement(conditional->otherwise), span)
            },
            ASTStatementKind::Match => {
                let matching = statement as *mut ASTMatchStatement;
                let result = this.arena.New<ASTMatchStatement>(this.CloneExpression(matching->scrutinee), span);

                for arm in matching->arms {
                    let copy = this.arena.New<ASTMatchArm>(arm->span);
                    copy->wildcard = arm->wildcard;
                    copy->body = this.CloneStatement(arm->body);

                    for pattern in arm->patterns {
                        copy->patterns.PushBack(this.CloneExpression(pattern));
                    }

                    result->arms.PushBack(copy);
                }

                result
            },
            ASTStatementKind::For => {
                let loop_statement = statement as *mut ASTForStatement;
                this.arena.New<ASTForStatement>(loop_statement->variable, this.CloneExpression(loop_statement->start), this.CloneExpression(loop_statement->end), this.CloneBlock(loop_statement->body), span)
            }
        }
    }

    fn CloneBlock(&mut this, block: *mut ASTBlockStatement) -> *mut ASTBlockStatement {
        let result = this.arena.New<ASTBlockStatement>(block->span);

        for child in block->statements {
            result->statements.PushBack(this.CloneStatement(child));
        }

        result
    }

    fn CheckAssign(&mut this, statement: *mut ASTAssignStatement, scope: *mut Scope, context: Context) {
        if context == Context::Comb && statement->nonblocking {
            this.Error("Use '=' in 'comb' blocks; '<-' is for 'seq' blocks.", statement->span);
        }

        if context == Context::Seq && !statement->nonblocking {
            this.Error("Use '<-' in 'seq' blocks; '=' is for 'comb' blocks and continuous assignments.", statement->span);
        }

        let symbol = this.CheckTarget(statement->target, scope, context);
        if symbol == null { return; }
        let element = statement->target->kind == ASTExpressionKind::Index && (statement->target as *mut ASTIndexExpression)->element != null;
        (statement->symbol, statement->whole) = (symbol, statement->target->kind == ASTExpressionKind::Path || element);
        this.RecordDriver(symbol, if context == Context::Comb { DriverKind::Comb } else { DriverKind::Seq }, this.block, statement->span);
        let target = statement->target->resolved;
        if target == null || target->IsError() { return; }

        if target->IsArray() {
            this.Error("Cannot assign a whole memory; assign one element at a time.", statement->target->span);
            return;
        }

        this.CheckExpression(statement->value, scope, context, target);
        this.Coerce(statement->value, target);
    }

    fn CheckMatch(&mut this, statement: *mut ASTMatchStatement, scope: *mut Scope, context: Context) {
        let _type = this.CheckExpression(statement->scrutinee, scope, context, null);
        if _type->IsError() { return; }

        if !_type->IsBits() && !_type->IsEnum() {
            this.Error("Cannot match on a value of type " + Quote(_type->Describe()) + ".", statement->scrutinee->span);
            return;
        }

        let mut covered = Vector<i64>();
        let mut wildcard = false;

        for arm in statement->arms {
            if wildcard {
                this.Error("This arm is unreachable because an earlier arm uses '_'.", arm->span);
            }

            for pattern in arm->patterns {
                let pattern_type = this.CheckExpression(pattern, scope, context, _type);
                if pattern_type->IsError() { continue; }

                if !pattern->constant {
                    this.Error("Match patterns must be constants.", pattern->span);
                    continue;
                }

                if !this.Coerce(pattern, _type) { continue; }

                if covered.Contains(pattern->value) {
                    this.Error("This pattern is unreachable because its value is already matched.", pattern->span);
                    continue;
                }

                covered.PushBack(pattern->value);
            }

            if arm->wildcard { wildcard = true; }
            this.CheckStatement(arm->body, scope, context);
        }

        if wildcard {
            statement->exhaustive = true;
        } else if _type->IsEnum() {
            statement->exhaustive = covered.Length() == _type->enumeration->values.Length();
        } else if _type->width < 20 {
            statement->exhaustive = covered.Length() as i64 == ((1 as i64) << (_type->width as i64));
        }
    }

    fn CollectAssigned(&this, statement: *mut ASTStatement, result: &mut Vector<*mut Symbol>) {
        match statement->kind {
            ASTStatementKind::Block => {
                for child in (statement as *mut ASTBlockStatement)->statements { this.CollectAssigned(child, result); }
            },
            ASTStatementKind::Assign => {
                let symbol = (statement as *mut ASTAssignStatement)->symbol;
                if symbol != null && !result.Contains(symbol) { result.PushBack(symbol); }
            },
            ASTStatementKind::If => {
                let conditional = statement as *mut ASTIfStatement;

                if conditional->folded {
                    if conditional->chosen != null { this.CollectAssigned(conditional->chosen, result); }
                    return;
                }

                this.CollectAssigned(conditional->then, result);
                if conditional->otherwise != null { this.CollectAssigned(conditional->otherwise, result); }
            },
            ASTStatementKind::Match => {
                for arm in (statement as *mut ASTMatchStatement)->arms { this.CollectAssigned(arm->body, result); }
            },
            ASTStatementKind::For => {
                let unrolled = (statement as *mut ASTForStatement)->unrolled;
                if unrolled != null { this.CollectAssigned(unrolled, result); }
            }
        }
    }

    fn Definite(&this, statement: *mut ASTStatement) -> Vector<*mut Symbol> {
        match statement->kind {
            ASTStatementKind::Block => {
                let mut result = Vector<*mut Symbol>();

                for child in (statement as *mut ASTBlockStatement)->statements {
                    result = Union(result, this.Definite(child));
                }

                result
            },
            ASTStatementKind::Assign => {
                let assign = statement as *mut ASTAssignStatement;
                let mut result = Vector<*mut Symbol>();
                if assign->symbol != null && assign->whole { result.PushBack(assign->symbol); }
                result
            },
            ASTStatementKind::If => {
                let conditional = statement as *mut ASTIfStatement;

                if conditional->folded {
                    if conditional->chosen == null { return Vector<*mut Symbol>(); }
                    return this.Definite(conditional->chosen);
                }

                if conditional->otherwise == null { return Vector<*mut Symbol>(); }
                Intersect(this.Definite(conditional->then), this.Definite(conditional->otherwise))
            },
            ASTStatementKind::Match => {
                let matching = statement as *mut ASTMatchStatement;
                if !matching->exhaustive || matching->arms.Empty() { return Vector<*mut Symbol>(); }
                let mut result = this.Definite(matching->arms[0]->body);

                for i in 1..matching->arms.Length() {
                    result = Intersect(result, this.Definite(matching->arms[i]->body));
                }

                result
            },
            ASTStatementKind::For => {
                let unrolled = (statement as *mut ASTForStatement)->unrolled;
                if unrolled == null { return Vector<*mut Symbol>(); }
                this.Definite(unrolled)
            }
        }
    }
}
