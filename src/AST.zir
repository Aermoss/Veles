}

class ASTPort : ASTNode {
    pub name: String,
    pub input: bool,
    pub registered: bool,
    pub declared: *mut ASTType,
    pub init: *mut ASTExpression,
    pub bidirectional: bool = false,
    pub condition: *mut ASTExpression = null,
    pub symbol: *mut Symbol = null;

    ASTPort(&mut this, name: &String, input: bool, registered: bool, declared: *mut ASTType, init: *mut ASTExpression, span: SourceSpan) : ASTNode(ASTNodeKind::Port, span) {
        (this.name, this.input, this.registered, this.declared, this.init) = (name, input, registered, declared, init);
    }
}

class ASTModuleItem : ASTItem {
    pub name: String,
    pub external: bool,
    pub parameters: Vector<String>,
    pub ports: Vector<*mut ASTPort>,
    pub items: Vector<*mut ASTItem>,
    pub info: *mut ModuleInfo = null;

    ASTModuleItem(&mut this, name: &String, external: bool, span: SourceSpan) : ASTItem(ASTItemKind::Module, span) {
