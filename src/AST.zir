    pub body: *mut ASTBlockStatement,
    pub registers: Vector<*mut Symbol>;

    ASTSeqItem(&mut this, clock: *mut ASTExpression, reset: *mut ASTExpression, body: *mut ASTBlockStatement, span: SourceSpan) : ASTItem(ASTItemKind::Seq, span) {
