    ASTSignalItem(&mut this, signal: ASTSignalKind, name: &String, declared: *mut ASTType, value: *mut ASTExpression, span: SourceSpan) : ASTItem(ASTItemKind::Signal, span) {
        (this.signal, this.name, this.declared, this.value) = (signal, name, declared, value);
    }
}

class ASTAssignItem : ASTItem {
    pub target: *mut ASTExpression,
    pub value: *mut ASTExpression,
    pub symbol: *mut Symbol = null;

    ASTAssignItem(&mut this, target: *mut ASTExpression, value: *mut ASTExpression, span: SourceSpan) : ASTItem(ASTItemKind::Assign, span) {
        (this.target, this.value) = (target, value);
    }
}

class ASTCombItem : ASTItem {
    pub body: *mut ASTBlockStatement;

    ASTCombItem(&mut this, body: *mut ASTBlockStatement, span: SourceSpan) : ASTItem(ASTItemKind::Comb, span) {
        this.body = body;
