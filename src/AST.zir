#[include "std/str", "std/vec", "src/Source.zir", "src/Semantic.zir" : *]

enum ASTNodeKind: u8 {
    Type, Expression, Statement, Port, Item
}

class ASTNode {
    pub kind: ASTNodeKind,
    pub span: SourceSpan;

    ASTNode(&mut this, kind: ASTNodeKind, span: SourceSpan) {
        (this.kind, this.span) = (kind, span);
    }

    virtual ~ASTNode(&mut this) {}
}

enum ASTTypeKind: u8 {
    Named, Sized, Array
}

class ASTType : ASTNode {
    pub kind: ASTTypeKind;

    ASTType(&mut this, kind: ASTTypeKind, span: SourceSpan) : ASTNode(ASTNodeKind::Type, span) {
        this.kind = kind;
    }
}

class ASTNamedType : ASTType {
    pub name: String;

    ASTNamedType(&mut this, name: &String, span: SourceSpan) : ASTType(ASTTypeKind::Named, span) {
        this.name = name;
    }
}

class ASTSizedType : ASTType {
    pub signed: bool,
    pub width: *mut ASTExpression;

    ASTSizedType(&mut this, signed: bool, width: *mut ASTExpression, span: SourceSpan) : ASTType(ASTTypeKind::Sized, span) {
        (this.signed, this.width) = (signed, width);
    }
}

class ASTArrayType : ASTType {
    pub element: *mut ASTType,
    pub length: *mut ASTExpression;

    ASTArrayType(&mut this, element: *mut ASTType, length: *mut ASTExpression, span: SourceSpan) : ASTType(ASTTypeKind::Array, span) {
        (this.element, this.length) = (element, length);
    }
}

enum ASTExpressionKind: u8 {
    Integer, Boolean, String, Path, Unary, Binary, Index, Slice, Member, Call, Cast, If, Instance
}

class ASTExpression : ASTNode {
    pub kind: ASTExpressionKind,
    pub resolved: *mut Type = null,
    pub constant: bool = false,
    pub value: i64 = 0;

    ASTExpression(&mut this, kind: ASTExpressionKind, span: SourceSpan) : ASTNode(ASTNodeKind::Expression, span) {
        this.kind = kind;
    }
}

class ASTIntegerLiteral : ASTExpression {
    pub literal: i64,
    pub radix: u32;

    ASTIntegerLiteral(&mut this, literal: i64, radix: u32, span: SourceSpan) : ASTExpression(ASTExpressionKind::Integer, span) {
        (this.literal, this.radix) = (literal, radix);
    }
}

class ASTBooleanLiteral : ASTExpression {
    pub literal: bool;

    ASTBooleanLiteral(&mut this, literal: bool, span: SourceSpan) : ASTExpression(ASTExpressionKind::Boolean, span) {
        this.literal = literal;
    }
}

class ASTStringLiteral : ASTExpression {
    pub text: String;

    ASTStringLiteral(&mut this, text: &String, span: SourceSpan) : ASTExpression(ASTExpressionKind::String, span) {
        this.text = text;
    }
}

class ASTPathExpression : ASTExpression {
    pub segments: Vector<String>,
    pub symbol: *mut Symbol = null;

    ASTPathExpression(&mut this, span: SourceSpan) : ASTExpression(ASTExpressionKind::Path, span) {}

    pub fn ToString(&this) -> String {
        let mut result = String();

        for i in 0..this.segments.Length() {
            if i > 0 { result += "::"; }
            result += this.segments[i];
        }

        result
    }
}

enum ASTUnaryKind: u8 {
    Negate, Not
}

class ASTUnaryExpression : ASTExpression {
    pub op: ASTUnaryKind,
    pub operand: *mut ASTExpression;

    ASTUnaryExpression(&mut this, op: ASTUnaryKind, operand: *mut ASTExpression, span: SourceSpan) : ASTExpression(ASTExpressionKind::Unary, span) {
        (this.op, this.operand) = (op, operand);
    }
}

enum ASTBinaryKind: u8 {
    Add, Subtract, Multiply, Divide, Modulo,
    BitwiseAnd, BitwiseOr, BitwiseXor, LeftShift, RightShift,
    Equal, NotEqual, Less, Greater, LessEqual, GreaterEqual,
    And, Or
}

extend ASTBinaryKind {
    pub fn Text(this) -> String {
        match this {
            ASTBinaryKind::Add => "+",
            ASTBinaryKind::Subtract => "-",
            ASTBinaryKind::Multiply => "*",
            ASTBinaryKind::Divide => "/",
            ASTBinaryKind::Modulo => "%",
            ASTBinaryKind::BitwiseAnd => "&",
            ASTBinaryKind::BitwiseOr => "|",
            ASTBinaryKind::BitwiseXor => "^",
            ASTBinaryKind::LeftShift => "<<",
            ASTBinaryKind::RightShift => ">>",
            ASTBinaryKind::Equal => "==",
            ASTBinaryKind::NotEqual => "!=",
            ASTBinaryKind::Less => "<",
            ASTBinaryKind::Greater => ">",
            ASTBinaryKind::LessEqual => "<=",
            ASTBinaryKind::GreaterEqual => ">=",
            ASTBinaryKind::And => "&&",
            ASTBinaryKind::Or => "||"
        }.ToString()
    }

    pub fn IsComparison(this) -> bool {
        this == ASTBinaryKind::Equal || this == ASTBinaryKind::NotEqual || this == ASTBinaryKind::Less ||
            this == ASTBinaryKind::Greater || this == ASTBinaryKind::LessEqual || this == ASTBinaryKind::GreaterEqual
    }

    pub fn IsLogical(this) -> bool {
        this == ASTBinaryKind::And || this == ASTBinaryKind::Or
    }

    pub fn IsShift(this) -> bool {
        this == ASTBinaryKind::LeftShift || this == ASTBinaryKind::RightShift
    }
}

class ASTBinaryExpression : ASTExpression {
    pub op: ASTBinaryKind,
    pub left: *mut ASTExpression,
    pub right: *mut ASTExpression,
    pub folded: *mut ASTExpression = null;

    ASTBinaryExpression(&mut this, op: ASTBinaryKind, left: *mut ASTExpression, right: *mut ASTExpression, span: SourceSpan) : ASTExpression(ASTExpressionKind::Binary, span) {
        (this.op, this.left, this.right) = (op, left, right);
    }
}

class ASTIndexExpression : ASTExpression {
    pub base: *mut ASTExpression,
    pub index: *mut ASTExpression,
    pub element: *mut ASTExpression = null,
    pub choices: Vector<*mut ASTExpression>;

    ASTIndexExpression(&mut this, base: *mut ASTExpression, index: *mut ASTExpression, span: SourceSpan) : ASTExpression(ASTExpressionKind::Index, span) {
        (this.base, this.index) = (base, index);
    }
}

class ASTSliceExpression : ASTExpression {
    pub base: *mut ASTExpression,
    pub high: *mut ASTExpression,
    pub low: *mut ASTExpression,
    pub high_value: i64 = 0,
    pub low_value: i64 = 0;

    ASTSliceExpression(&mut this, base: *mut ASTExpression, high: *mut ASTExpression, low: *mut ASTExpression, span: SourceSpan) : ASTExpression(ASTExpressionKind::Slice, span) {
        (this.base, this.high, this.low) = (base, high, low);
    }
}

class ASTMemberExpression : ASTExpression {
    pub base: *mut ASTExpression,
    pub name: String,
    pub instance: *mut Symbol = null,
    pub port: *mut Symbol = null;

    ASTMemberExpression(&mut this, base: *mut ASTExpression, name: &String, span: SourceSpan) : ASTExpression(ASTExpressionKind::Member, span) {
        (this.base, this.name) = (base, name);
    }
}

class ASTCallExpression : ASTExpression {
    pub name: String,
    pub arguments: Vector<*mut ASTExpression>;

    ASTCallExpression(&mut this, name: &String, span: SourceSpan) : ASTExpression(ASTExpressionKind::Call, span) {
        this.name = name;
    }
}

class ASTCastExpression : ASTExpression {
    pub operand: *mut ASTExpression,
    pub target: *mut ASTType;

    ASTCastExpression(&mut this, operand: *mut ASTExpression, target: *mut ASTType, span: SourceSpan) : ASTExpression(ASTExpressionKind::Cast, span) {
        (this.operand, this.target) = (operand, target);
    }
}

class ASTIfExpression : ASTExpression {
    pub condition: *mut ASTExpression,
    pub then: *mut ASTExpression,
    pub otherwise: *mut ASTExpression,
    pub chosen: *mut ASTExpression = null;

    ASTIfExpression(&mut this, condition: *mut ASTExpression, then: *mut ASTExpression, otherwise: *mut ASTExpression, span: SourceSpan) : ASTExpression(ASTExpressionKind::If, span) {
        (this.condition, this.then, this.otherwise) = (condition, then, otherwise);
    }
}

class ASTConnection {
    pub name: String,
    pub value: *mut ASTExpression,
    pub span: SourceSpan,
    pub text: String,
    pub port: *mut Symbol = null;

    ASTConnection(&mut this, name: &String, value: *mut ASTExpression, span: SourceSpan) {
        (this.name, this.value, this.span) = (name, value, span);
    }
}

class ASTInstanceExpression : ASTExpression {
    pub module: String,
    pub parameters: Vector<*mut ASTConnection>,
    pub connections: Vector<*mut ASTConnection>,
    pub target: *mut Symbol = null;

    ASTInstanceExpression(&mut this, module: &String, span: SourceSpan) : ASTExpression(ASTExpressionKind::Instance, span) {
        this.module = module;
    }
}

enum ASTStatementKind: u8 {
    Block, Assign, If, Match, For
}

class ASTStatement : ASTNode {
    pub kind: ASTStatementKind;

    ASTStatement(&mut this, kind: ASTStatementKind, span: SourceSpan) : ASTNode(ASTNodeKind::Statement, span) {
        this.kind = kind;
    }
}

class ASTBlockStatement : ASTStatement {
    pub statements: Vector<*mut ASTStatement>;

    ASTBlockStatement(&mut this, span: SourceSpan) : ASTStatement(ASTStatementKind::Block, span) {}
}

class ASTAssignStatement : ASTStatement {
    pub target: *mut ASTExpression,
    pub value: *mut ASTExpression,
    pub nonblocking: bool,
    pub symbol: *mut Symbol = null,
    pub whole: bool = false;

    ASTAssignStatement(&mut this, target: *mut ASTExpression, value: *mut ASTExpression, nonblocking: bool, span: SourceSpan) : ASTStatement(ASTStatementKind::Assign, span) {
        (this.target, this.value, this.nonblocking) = (target, value, nonblocking);
    }
}

class ASTIfStatement : ASTStatement {
    pub condition: *mut ASTExpression,
    pub then: *mut ASTBlockStatement,
    pub otherwise: *mut ASTStatement,
    pub folded: bool = false,
    pub chosen: *mut ASTStatement = null;

    ASTIfStatement(&mut this, condition: *mut ASTExpression, then: *mut ASTBlockStatement, otherwise: *mut ASTStatement, span: SourceSpan) : ASTStatement(ASTStatementKind::If, span) {
        (this.condition, this.then, this.otherwise) = (condition, then, otherwise);
    }
}

class ASTMatchArm {
    pub patterns: Vector<*mut ASTExpression>,
    pub wildcard: bool = false,
    pub body: *mut ASTStatement = null,
    pub span: SourceSpan;

    ASTMatchArm(&mut this, span: SourceSpan) {
        this.span = span;
    }
}

class ASTMatchStatement : ASTStatement {
    pub scrutinee: *mut ASTExpression,
    pub arms: Vector<*mut ASTMatchArm>,
    pub exhaustive: bool = false;

    ASTMatchStatement(&mut this, scrutinee: *mut ASTExpression, span: SourceSpan) : ASTStatement(ASTStatementKind::Match, span) {
        this.scrutinee = scrutinee;
    }
}

class ASTForStatement : ASTStatement {
    pub variable: String,
    pub start: *mut ASTExpression,
    pub end: *mut ASTExpression,
    pub body: *mut ASTBlockStatement,
    pub unrolled: *mut ASTBlockStatement = null;

    ASTForStatement(&mut this, variable: &String, start: *mut ASTExpression, end: *mut ASTExpression, body: *mut ASTBlockStatement, span: SourceSpan) : ASTStatement(ASTStatementKind::For, span) {
        (this.variable, this.start, this.end, this.body) = (variable, start, end, body);
    }
}

enum ASTItemKind: u8 {
    Const, Type, Enum, Module, Signal, Assign, Comb, Seq, For, If
}

class ASTItem : ASTNode {
    pub kind: ASTItemKind;

    ASTItem(&mut this, kind: ASTItemKind, span: SourceSpan) : ASTNode(ASTNodeKind::Item, span) {
        this.kind = kind;
    }
}

class ASTConstItem : ASTItem {
    pub name: String,
    pub declared: *mut ASTType,
    pub value: *mut ASTExpression,
    pub symbol: *mut Symbol = null;

    ASTConstItem(&mut this, name: &String, declared: *mut ASTType, value: *mut ASTExpression, span: SourceSpan) : ASTItem(ASTItemKind::Const, span) {
        (this.name, this.declared, this.value) = (name, declared, value);
    }
}

class ASTTypeItem : ASTItem {
    pub name: String,
    pub aliased: *mut ASTType,
    pub symbol: *mut Symbol = null;

    ASTTypeItem(&mut this, name: &String, aliased: *mut ASTType, span: SourceSpan) : ASTItem(ASTItemKind::Type, span) {
        (this.name, this.aliased) = (name, aliased);
    }
}

class ASTVariant {
    pub name: String,
    pub value: *mut ASTExpression,
    pub span: SourceSpan;

    ASTVariant(&mut this, name: &String, value: *mut ASTExpression, span: SourceSpan) {
        (this.name, this.value, this.span) = (name, value, span);
    }
}

class ASTEnumItem : ASTItem {
    pub name: String,
    pub base: *mut ASTType,
